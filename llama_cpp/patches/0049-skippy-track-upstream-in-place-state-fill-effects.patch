From ee45a5a07c6f1ed4fdffdb02dc40e7a756b1d711 Mon Sep 17 00:00:00 2001
From: Skippy CI <ci@skippy.local>
Date: Wed, 25 Nov 2026 07:22:58 +1100
Subject: [PATCH] skippy: track upstream in-place state fill effects

---
 src/skippy/state_effects.cpp             |  7 ++-
 src/skippy/tests/fill_state_regression.h | 56 ++++++++++++++++++++++++
 src/skippy/tests/stage_slice_plan.cpp    |  2 +
 3 files changed, 63 insertions(+), 2 deletions(-)
 create mode 100644 src/skippy/tests/fill_state_regression.h

diff --git a/src/skippy/state_effects.cpp b/src/skippy/state_effects.cpp
index b33ed2d5d..3b5690fc3 100644
--- a/src/skippy/state_effects.cpp
+++ b/src/skippy/state_effects.cpp
@@ -150,6 +150,7 @@ static const ggml_tensor * write_destination(const ggml_tensor * node) {
         case GGML_OP_SET_ROWS:
             return node->src[2];
         case GGML_OP_SCALE:
+        case GGML_OP_FILL:
             return node->view_src != nullptr ? node->src[0] : nullptr;
         default:
             return nullptr;
@@ -271,7 +272,8 @@ bool skippy_validate_state_effects(
 
     for (const auto & node_position : graph_positions) {
         const ggml_tensor * node = node_position.first;
-        if (node->op != GGML_OP_CPY && node->op != GGML_OP_SET_ROWS && node->op != GGML_OP_SCALE) {
+        if (node->op != GGML_OP_CPY && node->op != GGML_OP_SET_ROWS &&
+                node->op != GGML_OP_SCALE && node->op != GGML_OP_FILL) {
             continue;
         }
         const ggml_tensor * destination = write_destination(node);
@@ -357,7 +359,8 @@ bool skippy_infer_state_effects(
 
     for (int32_t index = 0; index < ggml_graph_n_nodes(const_cast<ggml_cgraph *>(graph)); ++index) {
         const ggml_tensor * node = ggml_graph_node(const_cast<ggml_cgraph *>(graph), index);
-        if (node->op != GGML_OP_CPY && node->op != GGML_OP_SET_ROWS && node->op != GGML_OP_SCALE) {
+        if (node->op != GGML_OP_CPY && node->op != GGML_OP_SET_ROWS &&
+                node->op != GGML_OP_SCALE && node->op != GGML_OP_FILL) {
             continue;
         }
         const ggml_tensor * storage = skippy_state_canonical_storage(write_destination(node));
diff --git a/src/skippy/tests/fill_state_regression.h b/src/skippy/tests/fill_state_regression.h
new file mode 100644
index 000000000..460e175a5
--- /dev/null
+++ b/src/skippy/tests/fill_state_regression.h
@@ -0,0 +1,56 @@
+// Upstream recurrent preparation now zeroes state with FILL rather than SCALE.
+static int check_fill_state_effects() {
+    ggml_init_params params = {ggml_tensor_overhead() * 32 + ggml_graph_overhead_custom(32, false), nullptr, true};
+    ggml_context_ptr ctx(ggml_init(params));
+    ggml_tensor * input = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 4);
+    ggml_tensor * state = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 4);
+    ggml_tensor * entry = ggml_add(ctx.get(), input, state);
+    ggml_tensor * fill = ggml_fill_inplace(ctx.get(), state, 0.0f);
+    ggml_tensor * output = ggml_add(ctx.get(), entry, fill);
+    ggml_cgraph * graph = ggml_new_graph_custom(ctx.get(), 32, false);
+    ggml_build_forward_expand(graph, entry);
+    ggml_build_forward_expand(graph, fill);
+    ggml_build_forward_expand(graph, output);
+    const std::vector<skippy_block_boundary> boundaries = {
+        {skippy_block_boundary_kind::entry, 0, entry},
+        {skippy_block_boundary_kind::exit, 0, output},
+    };
+    const std::vector<skippy_state_effect> reads = {
+        {skippy_state_kind::recurrent_conv, skippy_state_access::read, 0, state, nullptr},
+    };
+    auto effects = reads;
+    effects.push_back({skippy_state_kind::recurrent_conv, skippy_state_access::write, 0, state, fill, 0});
+    std::string error;
+    if (!skippy_validate_state_effects(effects, graph, error)) {
+        std::fprintf(stderr, "in-place state fill was rejected: %s\n", error.c_str());
+        return 140;
+    }
+    if (skippy_validate_state_effects(reads, graph, error)) {
+        std::fprintf(stderr, "unregistered in-place state fill was accepted\n");
+        return 141;
+    }
+    std::vector<skippy_state_effect> inferred;
+    if (!skippy_infer_state_effects(reads, graph, boundaries, inferred, error) ||
+            inferred.size() != 2 || inferred[1].effect_node != fill || inferred[1].write_ordinal != 0) {
+        std::fprintf(stderr, "in-place state fill inference failed: %s\n", error.c_str());
+        return 142;
+    }
+    fill->src[0] = input;
+    if (skippy_validate_state_effects(effects, graph, error)) {
+        std::fprintf(stderr, "state fill with a substituted destination was accepted\n");
+        return 143;
+    }
+    fill->src[0] = state;
+    ggml_tensor * copy = ggml_fill(ctx.get(), state, 0.0f);
+    ggml_build_forward_expand(graph, copy);
+    if (!skippy_validate_state_effects(effects, graph, error)) {
+        std::fprintf(stderr, "out-of-place fill was mistaken for a state mutation: %s\n", error.c_str());
+        return 144;
+    }
+    effects[1].effect_node = copy;
+    if (skippy_validate_state_effects(effects, graph, error)) {
+        std::fprintf(stderr, "out-of-place fill was accepted as a state write\n");
+        return 145;
+    }
+    return 0;
+}
diff --git a/src/skippy/tests/stage_slice_plan.cpp b/src/skippy/tests/stage_slice_plan.cpp
index 21f659cbd..ec3878c1a 100644
--- a/src/skippy/tests/stage_slice_plan.cpp
+++ b/src/skippy/tests/stage_slice_plan.cpp
@@ -1177,9 +1177,11 @@ static int check_auxiliary_graph_parameter_closure() {
 #include "residual_checkpoint_regression.h"
 #include "input_leaf_state_regression.h"
 #include "cast_destination_regression.h"
+#include "fill_state_regression.h"
 
 int main() {
     int result = check_cast_destination_clone();
+    if (!result) { result = check_fill_state_effects(); }
     if (!result) { result = check_input_leaf_state_inference(); }
     if (!result) { result = check_raw_embedding_checkpoint(); }
     if (!result) { result = check_semantic_identities(); }
-- 
