diff --git a/src/llama-memory-recurrent-copy.cpp b/src/llama-memory-recurrent-copy.cpp
index 9c269200b..e92039d4b 100644
--- a/src/llama-memory-recurrent-copy.cpp
+++ b/src/llama-memory-recurrent-copy.cpp
@@ -3,37 +3,87 @@
 #include "ggml-backend.h"
 
 #include <cstring>
+#include <set>
+#include "skippy/trace_scope.h"
 
-void llama_recurrent_copy_rows(
+// A row view lets shared-memory and device backends copy in their own memory
+// domain. The caller has already synchronized recurrent state before relocation.
+static ggml_tensor recurrent_row_view(ggml_tensor * tensor, uint32_t row, size_t bytes) {
+    ggml_tensor view = *tensor;
+    view.data = static_cast<uint8_t *>(tensor->data) + row * tensor->nb[1];
+    view.view_src = nullptr;
+    view.view_offs = 0;
+    for (int dim = 1; dim < GGML_MAX_DIMS; ++dim) {
+        view.ne[dim] = 1;
+        view.nb[dim] = bytes;
+    }
+    return view;
+}
+
+llama_recurrent_copy_stats llama_recurrent_copy_rows(
         const std::vector<ggml_tensor *> & tensors,
         const std::vector<std::vector<llama_recurrent_copy_row>> & groups,
         std::vector<uint8_t> & scratch) {
-    for (auto * tensor : tensors) {
-        if (!tensor || !tensor->buffer) {
-            continue;
+    skippy_trace::scope trace("native.recurrent_rollback_copy");
+    llama_recurrent_copy_stats stats;
+    for (const auto & group : groups) {
+        std::vector<llama_recurrent_copy_row> rows;
+        std::set<uint32_t> destinations;
+        for (const auto & row : group) {
+            if (!row.zero && row.source == row.destination) {
+                ++stats.skipped_rows;
+                continue;
+            }
+            GGML_ASSERT(destinations.insert(row.destination).second);
+            rows.push_back(row);
+        }
+        // No destination may destroy a source another row still needs. If
+        // there is an alias (including cycles/fan-out), retain gather-before-write.
+        bool aliases = false;
+        for (const auto & row : rows) {
+            aliases |= !row.zero && destinations.count(row.source) != 0;
         }
-        const size_t row_bytes = ggml_row_size(tensor->type, tensor->ne[0]);
-        for (const auto & rows : groups) {
-            if (rows.empty()) continue;
+        for (auto * tensor : tensors) {
+            if (!tensor || !tensor->buffer || rows.empty()) continue;
+            const size_t row_bytes = ggml_row_size(tensor->type, tensor->ne[0]);
+            for (const auto & row : rows) {
+                GGML_ASSERT(row.destination < tensor->ne[1]);
+                GGML_ASSERT(row.zero || row.source < tensor->ne[1]);
+            }
+            if (!aliases) {
+                for (const auto & row : rows) {
+                    auto destination = recurrent_row_view(tensor, row.destination, row_bytes);
+                    if (row.zero) {
+                        ggml_backend_tensor_memset(&destination, 0, 0, row_bytes);
+                    } else {
+                        auto source = recurrent_row_view(tensor, row.source, row_bytes);
+                        ggml_backend_tensor_copy(&source, &destination);
+                    }
+                    stats.direct_bytes += row_bytes;
+                }
+                continue;
+            }
             const size_t needed = rows.size() * row_bytes;
             if (scratch.size() < needed) scratch.resize(needed);
             for (size_t i = 0; i < rows.size(); ++i) {
                 const auto & row = rows[i];
-                GGML_ASSERT(row.destination < tensor->ne[1]);
                 auto * output = scratch.data() + i * row_bytes;
                 if (row.zero) {
                     std::memset(output, 0, row_bytes);
                 } else {
-                    GGML_ASSERT(row.source < tensor->ne[1]);
                     ggml_backend_tensor_get(tensor, output, row.source * tensor->nb[1], row_bytes);
+                    stats.staged_bytes += row_bytes;
                 }
             }
             for (size_t i = 0; i < rows.size(); ++i) {
                 ggml_backend_tensor_set(tensor, scratch.data() + i * row_bytes,
                         rows[i].destination * tensor->nb[1], row_bytes);
+                stats.staged_bytes += row_bytes;
             }
         }
     }
+    trace.set_value("host_staging_bytes", stats.staged_bytes);
+    return stats;
 }
 
 void llama_memory_recurrent::preserve_peer_rollback(uint32_t first, uint32_t last, uint32_t n_seqs) {
diff --git a/src/llama-memory-recurrent-copy.h b/src/llama-memory-recurrent-copy.h
index 6577e206d..7ed33ed71 100644
--- a/src/llama-memory-recurrent-copy.h
+++ b/src/llama-memory-recurrent-copy.h
@@ -12,9 +12,15 @@ struct llama_recurrent_copy_row {
     bool zero = false;
 };
 
+struct llama_recurrent_copy_stats {
+    size_t staged_bytes = 0;
+    size_t direct_bytes = 0;
+    size_t skipped_rows = 0;
+};
+
 // Groups must be ordered by destination snapshot plane. Sources are from the
 // same or a later plane; gather each group before writing to preserve aliases.
-void llama_recurrent_copy_rows(
+llama_recurrent_copy_stats llama_recurrent_copy_rows(
         const std::vector<ggml_tensor *> & tensors,
         const std::vector<std::vector<llama_recurrent_copy_row>> & groups,
         std::vector<uint8_t> & scratch);
diff --git a/src/skippy/tests/recurrent_copy.cpp b/src/skippy/tests/recurrent_copy.cpp
new file mode 100644
index 000000000..ca9641b9a
--- /dev/null
+++ b/src/skippy/tests/recurrent_copy.cpp
@@ -0,0 +1,52 @@
+#include "llama-memory-recurrent-copy.h"
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "CHECK failed: %s:%d %s\n", __FILE__, __LINE__, #x); std::exit(1); } } while (0)
+
+static void check(ggml_backend_buffer_type_t buft,
+                  const std::vector<std::vector<llama_recurrent_copy_row>> & groups,
+                  bool direct) {
+    auto * ctx = ggml_init({1024*1024, nullptr, true});
+    auto * tensor = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1024, 8);
+    auto buffer = ggml_backend_alloc_ctx_tensors_from_buft(ctx, buft);
+    CHECK(buffer);
+    std::vector<float> expected(8192), actual(8192);
+    for (size_t i = 0; i < expected.size(); ++i) expected[i] = float(i + 1);
+    ggml_backend_tensor_set(tensor, expected.data(), 0, ggml_nbytes(tensor));
+    for (const auto & rows : groups) {
+        const auto before = expected;
+        for (const auto & row : rows) {
+            for (size_t i = 0; i < 1024; ++i) {
+                expected[row.destination * 1024 + i] = row.zero ? 0 : before[row.source * 1024 + i];
+            }
+        }
+    }
+    std::vector<uint8_t> scratch;
+    const auto stats = llama_recurrent_copy_rows({tensor}, groups, scratch);
+    ggml_backend_tensor_get(tensor, actual.data(), 0, ggml_nbytes(tensor));
+    CHECK(actual == expected);
+    if (direct) CHECK(scratch.empty() && stats.staged_bytes == 0);
+    else CHECK(!scratch.empty() && stats.staged_bytes > 0);
+    std::printf("staged=%zu direct=%zu skipped=%zu scratch=%zu\n",
+                stats.staged_bytes, stats.direct_bytes, stats.skipped_rows, scratch.size());
+    ggml_backend_buffer_free(buffer);
+    ggml_free(ctx);
+}
+
+int main(int argc, char ** argv) {
+    ggml_backend_load_all();
+    auto * device = ggml_backend_dev_by_name(argc > 1 ? argv[1] : "CPU");
+    CHECK(device);
+    auto buft = ggml_backend_dev_buffer_type(device);
+    check(buft, {{{0, 0}, {1, 1}, {2, 5}, {2, 6}, {0, 7, true}}}, true);
+    check(buft, {{{0, 1}, {1, 0}, {2, 2}}}, false); // swap
+    check(buft, {{{0, 1}, {1, 2}, {2, 0}, {0, 3}}}, false); // cycle and fan-out
+    check(buft, {{{0, 1}, {0, 0, true}}}, false); // zeroing must not destroy a source
+    check(buft, {{{4, 0}, {5, 1}}, {{6, 4}, {7, 5}}}, true); // ascending snapshot planes
+    check(buft, {{{0, 0}, {1, 1}}}, true); // identity-only: no allocation/copy
+}
