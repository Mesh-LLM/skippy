 }
+
+// one core pass: pass 0 rebuilds the physical core layers, later passes replay
+// them into fresh loop slots fed by the bank of the previous pass
+ggml_tensor * llama_model_inkling2_loop::graph::build_core_pass(uint32_t pass, ggml_tensor * cur,
+        std::vector<ggml_tensor *> & blocks, const std::vector<ggml_tensor *> & bank, ggml_tensor * bank_out, int & visit) {
+    const auto & m = static_cast<const llama_model_inkling2_loop &>(model);
+    const int n_layer_core = m.core_end - m.core_start;
+    for (int ip = m.core_start; ip < m.core_start + n_layer_core; ++ip) {
+        const int il = pass == 0 ? ip : m.n_phys + (pass - 1)*n_layer_core + (ip - m.core_start);
+        res->t_layer_inp[visit++] = cur;
+        if (pass == 0) {
+            cur = build_layer(il, ip, cur, blocks);
+            continue;
+        }
+        const auto & loop = m.loop_layers[ip - m.core_start];
+        cur = build_layer(il, ip, cur, blocks, mix(bank, bank_out, loop.msg_query), &loop);
+    }
+    return cur;
+}
