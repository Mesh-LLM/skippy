From 15bc36234d59beb17460b8e6e1da9183aa52387b Mon Sep 17 00:00:00 2001
From: Skippy CI <ci@skippy.local>
Date: Wed, 25 Nov 2026 07:34:04 +1100
Subject: [PATCH] gemma4: register request inputs for shared KV pruning

---
 src/models/gemma4.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/models/gemma4.cpp b/src/models/gemma4.cpp
index 3bb8db05a..80a5890a6 100644
--- a/src/models/gemma4.cpp
+++ b/src/models/gemma4.cpp
@@ -260,6 +260,11 @@ llama_model_gemma4::graph::graph(const llm_graph_params & params) :
             ggml_set_input(prune_input->inp_prune_ids);
             ggml_set_input(prune_input->inp_prune_keep);
 
+            request_input(prune_input->out_mask, "gemma4.prune.mask");
+            request_input(prune_input->out_mask_swa, "gemma4.prune.mask_swa");
+            request_input(prune_input->inp_prune_ids, "gemma4.prune.ids");
+            request_input(prune_input->inp_prune_keep, "gemma4.prune.keep");
+
             inp_prune_ids  = prune_input->inp_prune_ids;
             inp_prune_keep = prune_input->inp_prune_keep;
 
-- 
