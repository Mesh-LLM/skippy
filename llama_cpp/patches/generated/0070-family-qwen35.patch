From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate qwen35 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/qwen35.cpp b/src/models/qwen35.cpp
index 6c71af445ef49693978a6dccf131685e57464b78..dd6f9a426c7fb79f085bb71b6551cb8947ece965 100644
--- a/src/models/qwen35.cpp
+++ b/src/models/qwen35.cpp
@@ -161,6 +161,8 @@ llama_model_qwen35::graph::graph(const llm_graph_params & params) :
 
     // MTP/NextN layers are loaded as extra decoder blocks but not executed in the main pass.
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         res->t_layer_inp[il] = inpL;
 
         ggml_tensor * inpSA = inpL;
@@ -208,6 +210,7 @@ llama_model_qwen35::graph::graph(const llm_graph_params & params) :
 
         // Input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
