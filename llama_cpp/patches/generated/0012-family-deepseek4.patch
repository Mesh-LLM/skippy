From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate deepseek4 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/deepseek4.cpp b/src/models/deepseek4.cpp
index 6f7b00f3b7aa79c6711aba30f76f12635254f5d6..b44cd6c474409cb830a6ce2d85b063e88dc00ed4 100644
--- a/src/models/deepseek4.cpp
+++ b/src/models/deepseek4.cpp
@@ -1220,6 +1220,8 @@ llama_model_deepseek4::graph::graph(const llm_graph_params & params) :
     cb(inpL, "hc_init", -1);
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         if ((size_t) il < cparams.embeddings_layer_inp.size() && cparams.embeddings_layer_inp[il]) {
             res->t_layer_inp[il] = build_hc_mean(inpL);
             cb(res->t_layer_inp[il], "layer_inp", il);
@@ -1304,6 +1306,7 @@ llama_model_deepseek4::graph::graph(const llm_graph_params & params) :
         inpL = build_hc_post(cur, residual, ffn_hc.post, ffn_hc.comb, il);
         inpL = build_cvec(inpL, il);
         cb(inpL, "l_last", il);
+        end_block(inpL, il);
     }
 
     if ((size_t) n_layer < cparams.embeddings_layer_inp.size() && cparams.embeddings_layer_inp[n_layer]) {
diff --git a/src/models/dflash.cpp b/src/models/dflash.cpp
index ab1cc749d61490c0d0a36d3c35b912b6991f728d..2538cc91d1e85165a68a985a8467c165cc906813 100644
--- a/src/models/dflash.cpp
+++ b/src/models/dflash.cpp
@@ -634,6 +634,8 @@ ggml_tensor * llama_model_dflash::graph_base::build_layers(ggml_tensor * tok_emb
     dspine_stash dspine;
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         const auto & layer = model.layers[il];
 
         ggml_tensor * noise_norm = build_norm(inpL, layer.attn_norm, NULL, LLM_NORM_RMS, il);
@@ -753,6 +755,7 @@ ggml_tensor * llama_model_dflash::graph_base::build_layers(ggml_tensor * tok_emb
         cb(cur, "l_out", il);
 
         inpL = cur;
+        end_block(inpL, il);
     }
 
     ggml_tensor * cur = build_norm(inpL, model.output_norm, NULL, LLM_NORM_RMS, -1);
-- 
