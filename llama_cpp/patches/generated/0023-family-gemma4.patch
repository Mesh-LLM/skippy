From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate gemma4 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/gemma4.cpp b/src/models/gemma4.cpp
index d8bf44a1205ef674bb15e9916447c556cfb255e6..80a5890a67b09212825f161f1171cdc6cdfd6916 100644
--- a/src/models/gemma4.cpp
+++ b/src/models/gemma4.cpp
@@ -236,6 +236,8 @@ llama_model_gemma4::graph::graph(const llm_graph_params & params) :
     ggml_tensor * inp_out_ids = prune_shared ? nullptr : build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         if (prune_shared && il == (int) hparams.n_layer_kv_from_start) {
             ggml_tensor * full     = inp_attn->self_attn_mask.raw;
             ggml_tensor * full_swa = inp_attn->self_attn_mask_swa.raw;
@@ -478,6 +480,7 @@ llama_model_gemma4::graph::graph(const llm_graph_params & params) :
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
     if (prune_shared) {
