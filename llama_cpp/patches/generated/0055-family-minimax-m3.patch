From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate minimax-m3 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/minimax-m3.cpp b/src/models/minimax-m3.cpp
index 313c8301d64721bf0d03a7f5b0045c3bb5815b21..e50619e0e2237e2be2de0e72a56f6131e2486c7f 100644
--- a/src/models/minimax-m3.cpp
+++ b/src/models/minimax-m3.cpp
@@ -330,6 +330,8 @@ llama_model_minimax_m3::graph::graph(const llm_graph_params & params) : llm_grap
     const bool extract_last = (size_t) n_layer < cparams.embeddings_layer_inp.size() && cparams.embeddings_layer_inp[n_layer];
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         res->t_layer_inp[il] = inpL;
 
         ggml_tensor * inpSA = inpL;
@@ -615,6 +617,7 @@ llama_model_minimax_m3::graph::graph(const llm_graph_params & params) : llm_grap
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     if (extract_last) {
