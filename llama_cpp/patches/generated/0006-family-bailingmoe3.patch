From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate bailingmoe3 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/bailingmoe3.cpp b/src/models/bailingmoe3.cpp
index 30dcf61c31c06c696ac72e36471cf1bebe546eff..44549295c6064a43450e73ae2b84bf5722b256e0 100644
--- a/src/models/bailingmoe3.cpp
+++ b/src/models/bailingmoe3.cpp
@@ -224,6 +224,8 @@ llama_model_bailingmoe3::graph::graph(const llm_graph_params & params) :
     GGML_ASSERT(ubatch.n_tokens == n_seq_tokens * n_seqs);
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         res->t_layer_inp[il] = inpL;
 
         const auto & layer = model.layers[il];
@@ -366,6 +368,7 @@ llama_model_bailingmoe3::graph::graph(const llm_graph_params & params) :
         cur = build_cvec(cur, il);
         cb(cur, "l_out", il);
         inpL = cur;
+        end_block(inpL, il);
     }
 
     ggml_tensor * cur = build_norm(inpL, model.output_norm, nullptr, LLM_NORM_RMS, -1);
-- 
