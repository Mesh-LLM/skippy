From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate jais2 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/jais2.cpp b/src/models/jais2.cpp
index 1f077fd8699b0a683a0cc0f561fec8e9b7c928d8..3141e19d37159d005c7e2cc1188b855dd531055e 100644
--- a/src/models/jais2.cpp
+++ b/src/models/jais2.cpp
@@ -75,6 +75,8 @@ llama_model_jais2::graph::graph(const llm_graph_params & params) : llm_graph_con
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         // Pre-attention LayerNorm
         cur = build_norm(inpL,
                 model.layers[il].attn_norm,
@@ -129,6 +131,7 @@ llama_model_jais2::graph::graph(const llm_graph_params & params) : llm_graph_con
         inpL = ggml_add(ctx0, cur, ffn_inp);
         inpL = build_cvec(inpL, il);
         cb(inpL, "l_out", il);
+        end_block(inpL, il);
     }
 
     // Final LayerNorm
