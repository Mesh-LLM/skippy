diff --git a/tests/test-skippy-gdn-snapshots.cpp b/tests/test-skippy-gdn-snapshots.cpp
new file mode 100644
index 000000000..317b9c5d9
--- /dev/null
+++ b/tests/test-skippy-gdn-snapshots.cpp
@@ -0,0 +1,112 @@
+// ggml_gated_delta_net_at on the CPU: slot 0 is the final state and slot s + 1 the state after
+// token at[s], bit for bit what ggml_gated_delta_net keeps when it keeps every token's state.
+#include "ggml.h"
+#include "ggml-cpu.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <numeric>
+#include <random>
+#include <vector>
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { ++failures; std::printf("FAIL line %d: %s\n", __LINE__, #cond); } } while (0)
+
+static const int64_t S        = 16;
+static const int64_t H        = 2;
+static const int64_t n_tokens = 37;
+static const int64_t n_seqs   = 2;
+static const int64_t n_at     = 3;
+
+static ggml_tensor * filled(ggml_context * ctx, std::mt19937 & rng, float lo, float hi,
+                            int64_t ne0, int64_t ne1, int64_t ne2, int64_t ne3) {
+    ggml_tensor * t = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, ne0, ne1, ne2, ne3);
+    std::uniform_real_distribution<float> dist(lo, hi);
+    std::vector<float> values(ggml_nelements(t));
+    std::generate(values.begin(), values.end(), [&]() { return dist(rng); });
+    std::memcpy(t->data, values.data(), ggml_nbytes(t));
+    return t;
+}
+
+static std::vector<float> floats_of(const ggml_tensor * t) {
+    std::vector<float> values(ggml_nelements(t));
+    std::memcpy(values.data(), t->data, ggml_nbytes(t));
+    return values;
+}
+
+// the S*S*H floats of one sequence in one snapshot slot
+static std::vector<float> slot_of(const std::vector<float> & out, int64_t slot, int64_t seq) {
+    const int64_t attn  = S * H * n_tokens * n_seqs;
+    const int64_t per   = S * S * H;
+    const auto    first = out.begin() + attn + slot * per * n_seqs + seq * per;
+    return std::vector<float>(first, first + per);
+}
+
+static void snapshots_match_the_states_they_name(bool kda) {
+    ggml_init_params params = { 64u * 1024 * 1024, nullptr, false };
+    ggml_context * ctx = ggml_init(params);
+    std::mt19937 rng(kda ? 7 : 3);
+
+    ggml_tensor * q     = filled(ctx, rng, -0.3f, 0.3f, S, H, n_tokens, n_seqs);
+    ggml_tensor * k     = filled(ctx, rng, -0.3f, 0.3f, S, H, n_tokens, n_seqs);
+    ggml_tensor * v     = filled(ctx, rng, -1.0f, 1.0f, S, H, n_tokens, n_seqs);
+    ggml_tensor * g     = filled(ctx, rng, -2.0f, -1e-3f, kda ? S : 1, H, n_tokens, n_seqs);
+    ggml_tensor * beta  = filled(ctx, rng, 0.0f, 1.0f, 1, H, n_tokens, n_seqs);
+    ggml_tensor * state = filled(ctx, rng, -0.1f, 0.1f, S, S, H, n_seqs);
+
+    // a repeat, the first and last token, and a token outside the batch
+    const std::vector<int32_t> tokens = { 5, 0, 36, 20, 20, -1 };
+    ggml_tensor * at = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_at, n_seqs);
+    std::memcpy(at->data, tokens.data(), ggml_nbytes(at));
+
+    ggml_tensor * every = ggml_gated_delta_net(ctx, q, k, v, g, beta, state, n_tokens);
+    ggml_tensor * snaps = ggml_gated_delta_net_at(ctx, q, k, v, g, beta, state, at);
+    CHECK(snaps->op == GGML_OP_GATED_DELTA_NET_AT);
+    CHECK(snaps->ne[1] == n_tokens * n_seqs + (1 + n_at) * S * n_seqs);
+
+    const float sentinel = 1234.5f;
+    std::vector<float> unwritten(ggml_nelements(snaps), sentinel);
+    std::memcpy(snaps->data, unwritten.data(), ggml_nbytes(snaps));
+
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, every);
+    ggml_build_forward_expand(gf, snaps);
+    CHECK(ggml_graph_compute_with_ctx(ctx, gf, 4) == GGML_STATUS_SUCCESS);
+
+    const auto every_out = floats_of(every);
+    const auto snaps_out = floats_of(snaps);
+    const int64_t attn   = S * H * n_tokens * n_seqs;
+    CHECK(std::equal(snaps_out.begin(), snaps_out.begin() + attn, every_out.begin()));
+
+    std::vector<int64_t> seqs(n_seqs);
+    std::iota(seqs.begin(), seqs.end(), int64_t(0));
+    std::for_each(seqs.begin(), seqs.end(), [&](int64_t seq) {
+        CHECK(slot_of(snaps_out, 0, seq) == slot_of(every_out, 0, seq));
+        std::vector<int64_t> slots(n_at);
+        std::iota(slots.begin(), slots.end(), int64_t(0));
+        std::for_each(slots.begin(), slots.end(), [&](int64_t s) {
+            const int32_t token = tokens[seq * n_at + s];
+            const auto    got   = slot_of(snaps_out, s + 1, seq);
+            if (token < 0 || token >= n_tokens) {
+                CHECK(std::all_of(got.begin(), got.end(), [&](float x) { return x == sentinel; }));
+            } else {
+                CHECK(got == slot_of(every_out, n_tokens - 1 - token, seq));
+            }
+        });
+    });
+
+    ggml_free(ctx);
+}
