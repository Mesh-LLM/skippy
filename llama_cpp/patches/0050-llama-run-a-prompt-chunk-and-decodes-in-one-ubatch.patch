 #include <algorithm>
 #include <sstream>
 
+llama_ubatch_group llama_ubatch::group(uint32_t ig) const {
+    if (!is_grouped()) {
+        GGML_ASSERT(ig == 0);
+
+        return { n_seq_tokens, n_seqs, 0, 0 };
+    }
+
+    return data->groups.at(ig);
+}
+
+static llama_ubatch_group llama_ubatch_group_of(const llama_ubatch & ubatch, uint32_t s) {
+    for (uint32_t ig = 0; ig < ubatch.n_groups(); ++ig) {
+        const auto g = ubatch.group(ig);
+
+        if (s < g.i_seq + g.n_seqs) {
+            return g;
+        }
+    }
+
+    GGML_ABORT("%s: sequence set %u is not in the ubatch", __func__, s);
+}
+
+uint32_t llama_ubatch::seq_token_begin(uint32_t s) const {
+    const auto g = llama_ubatch_group_of(*this, s);
+
+    return g.i_token + (s - g.i_seq)*g.n_seq_tokens;
+}
+
+uint32_t llama_ubatch::seq_n_tokens(uint32_t s) const {
+    return llama_ubatch_group_of(*this, s).n_seq_tokens;
+}
+
