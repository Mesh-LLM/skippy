diff --git a/tests/test-batch-alloc.cpp b/tests/test-batch-alloc.cpp
index eee60d81d..1d306c484 100644
--- a/tests/test-batch-alloc.cpp
+++ b/tests/test-batch-alloc.cpp
@@ -868,6 +868,177 @@ static void test_keep_tail(testing & t) {
     });
 }
 
+static void test_grouped(testing & t) {
+    llama_vocab vocab;
+
+    auto make_batch = [](batch_builder & bb, std::initializer_list<int> n_tokens) {
+        llama_seq_id s = 0;
+        for (int n : n_tokens) {
+            for (int i = 0; i < n; ++i) {
+                bb.add(i, {s}, i == n - 1);
+            }
+            ++s;
+        }
+    };
+
+    t.test("prompt_and_decodes_share_a_ubatch", [&](testing & t) {
+        batch_builder bb;
+        make_batch(bb, {1, 6, 1});
+
+        llama_batch_allocr ba(1);
+        t.assert_true(ba.init(bb.b, vocab, false));
+
+        llama_ubatch ub = ba.split_equal_grouped(8, 0, 4);
+        t.assert_equal(8u, ub.n_tokens);
+        t.assert_true(ub.is_grouped());
+        t.assert_true(!ub.equal_seqs());
+        t.assert_equal(0u, ub.n_seq_tokens);
+        t.assert_equal(3u, ub.n_seqs);
+        t.assert_equal(2u, ub.n_groups());
+
+        // the decodes of seqs 0 and 2, then the prompt of seq 1
+        t.assert_equal(1u, ub.group(0).n_seq_tokens);
+        t.assert_equal(2u, ub.group(0).n_seqs);
+        t.assert_equal(6u, ub.group(1).n_seq_tokens);
+        t.assert_equal(1u, ub.group(1).n_seqs);
+        t.assert_equal(2u, ub.group(1).i_token);
+        t.assert_equal(2u, ub.group(1).i_seq);
+
+        t.assert_equal(1u, ub.seq_token_begin(1));
+        t.assert_equal(2u, ub.seq_token_begin(2));
+        t.assert_equal(1u, ub.seq_n_tokens(1));
+        t.assert_equal(6u, ub.seq_n_tokens(2));
+        t.assert_equal(2, ub.seq_id[1][0]);
+        t.assert_equal(1, ub.seq_id[2][0]);
+
+        // in the order of the sequence sets, so that each group has a slice
+        t.assert_equal(0, ub.seq_id_unq[0]);
+        t.assert_equal(2, ub.seq_id_unq[1]);
+        t.assert_equal(1, ub.seq_id_unq[2]);
+        t.assert_equal(1, ub.seq_idx[2]);
+        t.assert_equal(2, ub.seq_idx[1]);
+
+        llama_ubatch view = ub.group_view(0);
+        t.assert_true(view.equal_seqs());
+        t.assert_true(!view.is_grouped());
+        t.assert_equal(2u, view.n_tokens);
+        t.assert_equal(1u, view.n_seq_tokens);
+        t.assert_equal(2u, view.n_seqs_unq);
+        t.assert_equal(0, view.seq_id_unq[0]);
+        t.assert_equal(2, view.seq_id_unq[1]);
+        t.assert_equal(2, view.seq_id[1][0]);
+        t.assert_equal(1, (int) view.output[1]);
+
+        view = ub.group_view(1);
+        t.assert_equal(6u, view.n_tokens);
+        t.assert_equal(6u, view.n_seq_tokens);
+        t.assert_equal(1, view.seq_id_unq[0]);
+        t.assert_equal(5, view.pos[5]);
+        t.assert_equal(1, (int) view.output[5]);
+
+        t.assert_equal(0u, ba.split_equal_grouped(8, 0, 4).n_tokens);
+        t.assert_equal(8u, ba.get_n_used());
+    });
+
+    t.test("the_level_caps_the_long_set", [&](testing & t) {
+        batch_builder bb;
+        make_batch(bb, {10, 1});
+
+        llama_batch_allocr ba(1);
+        t.assert_true(ba.init(bb.b, vocab, false));
+
+        llama_ubatch ub = ba.split_equal_grouped(8, 0, 4);
