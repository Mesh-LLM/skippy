+llama_ubatch llama_batch_allocr::split_equal_grouped(uint32_t n_ubatch, uint32_t n_keep_tail, uint32_t n_groups_max) {
+    if (has_cpl || n_groups_max < 2) {
+        return split_equal(n_ubatch, false, n_keep_tail);
+    }
+
+    // without coupled sequences, two sequence sets are either equal or disjoint
+    std::vector<seq_set_t> cur_seq_set;
+
+    for (int32_t i = 0; i < batch.n_tokens && cur_seq_set.size() < n_ubatch; ++i) {
+        if (used[i] || std::find(cur_seq_set.begin(), cur_seq_set.end(), seq_set[i]) != cur_seq_set.end()) {
+            continue;
+        }
+
+        cur_seq_set.push_back(seq_set[i]);
+    }
+
+    const uint32_t n_seqs = cur_seq_set.size();
+
+    if (n_seqs == 0) {
+        return {};
+    }
+
+    std::vector<int32_t>  cur_idx(n_seqs, 0);
+    std::vector<uint32_t> n_left (n_seqs);
+
+    for (uint32_t s = 0; s < n_seqs; ++s) {
+        const auto & seq_idxs = seq_set_map[cur_seq_set[s]];
+
+        while (used[seq_idxs[cur_idx[s]]]) {
+            ++cur_idx[s];
+        }
+
+        n_left[s] = (uint32_t) (seq_idxs.size() - cur_idx[s]);
+    }
+
+    // the largest level such that taking min(n_left, level) tokens of every set fits n_ubatch
+    std::vector<uint32_t> n_sorted = n_left;
+    std::sort(n_sorted.begin(), n_sorted.end());
+
+    uint32_t n_level = 0;
+    uint32_t n_whole = 0; // tokens of the sets that fit whole
+
+    for (uint32_t k = 0; k < n_seqs; ++k) {
+        const uint32_t n_max = (n_ubatch - n_whole)/(n_seqs - k);
+
+        if (n_max < n_sorted[k]) {
+            n_level = n_max;
+            break;
+        }
+
+        n_level  = n_sorted[k];
+        n_whole += n_sorted[k];
+    }
+
+    std::vector<uint32_t> n_take(n_seqs);
+
+    for (uint32_t s = 0; s < n_seqs; ++s) {
+        n_take[s] = std::min(n_left[s], n_level);
+
+        // a set that does not finish here leaves at least n_keep_tail tokens, see split_equal
+        if (n_take[s] < n_left[s] && n_left[s] - n_take[s] < n_keep_tail) {
+            n_take[s] = n_left[s] > n_keep_tail ? n_left[s] - n_keep_tail : 0;
+        }
+    }
+
+    // a group per distinct length, in the order of the sets; the sets of the groups past n_groups_max wait
+    std::vector<uint32_t> group_len;
+
+    for (uint32_t s = 0; s < n_seqs; ++s) {
+        if (n_take[s] > 0 && std::find(group_len.begin(), group_len.end(), n_take[s]) == group_len.end()) {
+            group_len.push_back(n_take[s]);
+        }
+    }
+
+    if (group_len.empty()) {
+        // every set has fewer than n_keep_tail tokens left and does not fit whole
+        return split_equal(n_ubatch, false, n_keep_tail);
+    }
+
+    if (group_len.size() > n_groups_max) {
+        group_len.resize(n_groups_max);
+    }
+
+    std::vector<int32_t> idxs;
+    std::vector<llama_ubatch_group> groups;
+
+    uint32_t n_seqs_cur = 0;
+
+    for (const uint32_t len : group_len) {
+        llama_ubatch_group g = { len, 0, (uint32_t) idxs.size(), n_seqs_cur };
+
+        for (uint32_t s = 0; s < n_seqs; ++s) {
+            if (n_take[s] != len) {
+                continue;
+            }
+
+            const auto & seq_idxs = seq_set_map[cur_seq_set[s]];
+
+            for (uint32_t k = 0; k < len; ++k) {
+                const int32_t idx = seq_idxs[cur_idx[s] + k];
+
+                idxs.push_back(idx);
+
+                used[idx] = true;
+                ++n_used;
+            }
+
+            ++g.n_seqs;
+        }
+
+        n_seqs_cur += g.n_seqs;
+
+        groups.push_back(g);
+    }
+
+    if (groups.size() == 1) {
+        return ubatch_add(idxs, n_seqs_cur, true);
+    }
+
+    return ubatch_add(idxs, n_seqs_cur, false, std::move(groups));
+}
