From a6d26c33b6713c54d8d0ffad4712f606d977cd9d Mon Sep 17 00:00:00 2001
From: Skippy contributors <ci@skippy.local>
Date: Fri, 27 Nov 2026 09:40:34 +1100
Subject: [PATCH] ggml-cuda: report copies, allocations and BLAS setup as trace
 spans

The CUDA backend, which ROCm and MUSA builds compile too, did not expose
ggml_backend_set_trace_span_callback. So a trace on a discrete or APU GPU
could not show the time spent moving data between host and device: logits
read back each step, KV state saved and restored, inputs uploaded, weights
loaded. It also could not show allocation and pool stalls.

With a span callback installed, the backend reports:
- upload, download and copy: blocking copies, timed on the host
- upload_async, download_async and copy_async: copies queued on a
  backend's stream, timed by two events and reported at the next
  synchronize, as computes are
- buffer_alloc and host_buffer_alloc: device and pinned allocations
- pool_grow and pool_flush: pool growth, and a failed allocation that
  synchronizes the device to free the pool's cache
- blas_init: the first BLAS handle for a device and stream
- host_register and host_unregister: pinning a caller's memory around a
  batched read, and releasing it

Names start with rocm., musa. or cuda., as the command timing does.
Copies give the tensor as detail, or the tensor count for a batch.

A trace span now carries one named value, such as "bytes". Spans that end
before the first callback are kept, up to 256, as Metal keeps them. A
process that never installs one stops timing them once it has kept that
many.
---
 ggml/include/ggml-backend.h               |   4 +
 ggml/src/ggml-cuda/batch-get.cu           |   8 +-
 ggml/src/ggml-cuda/command-timing.cu      | 165 +++++++++++++++++++---
 ggml/src/ggml-cuda/command-timing.cuh     |   7 +
 ggml/src/ggml-cuda/common.cuh             |  25 ++++
 ggml/src/ggml-cuda/ggml-cuda.cu           |  69 ++++++++-
 ggml/src/ggml-metal/ggml-metal-timing.cpp |   4 +-
 src/skippy/tracing.cpp                    |   2 +-
 tests/test-skippy-tracing.cpp             |  10 +-
 9 files changed, 265 insertions(+), 29 deletions(-)

diff --git a/ggml/include/ggml-backend.h b/ggml/include/ggml-backend.h
index fced5e821..f882bb753 100644
--- a/ggml/include/ggml-backend.h
+++ b/ggml/include/ggml-backend.h
@@ -363,8 +363,12 @@ extern "C" {
         const char * name;
         // NULL, or what the span worked on; valid only during the callback
         const char * detail;
+        // host times, except a copy the backend timed on its stream (a name ending "_async")
         int64_t      start_unix_ns;
         int64_t      end_unix_ns;
+        // NULL, or the name of one measured quantity, such as "bytes"; static storage
+        const char * value_name;
+        int64_t      value;
     };
 
     typedef void (*ggml_backend_trace_span_callback_t)(
diff --git a/ggml/src/ggml-cuda/batch-get.cu b/ggml/src/ggml-cuda/batch-get.cu
index 60c4747b9..b92a5ee6d 100644
--- a/ggml/src/ggml-cuda/batch-get.cu
+++ b/ggml/src/ggml-cuda/batch-get.cu
@@ -54,8 +54,10 @@ struct ggml_cuda_batch_get_mapping {
     void * host = nullptr;
     unsigned char * device = nullptr;
 
-    ggml_cuda_batch_get_mapping(void * host, size_t size) {
+    ggml_cuda_batch_get_mapping(void * host, size_t size) : size(size) {
+        const int64_t span_start = ggml_cuda_trace_span_start();
         const cudaError_t err = cudaHostRegister(host, size, cudaHostRegisterMapped | cudaHostRegisterPortable);
+        ggml_cuda_trace_span_end(GGML_CUDA_SPAN_PREFIX "host_register", err != cudaSuccess ? "failed" : nullptr, span_start, "bytes", (int64_t) size);
         if (err != cudaSuccess) {
             (void) cudaGetLastError();
             GGML_LOG_DEBUG("%s: failed to register %.2f MiB of pinned memory: %s\n", __func__,
@@ -76,9 +78,13 @@ struct ggml_cuda_batch_get_mapping {
     ~ggml_cuda_batch_get_mapping() {
         if (host) {
             // Release only the registration acquired by this object.
+            const int64_t span_start = ggml_cuda_trace_span_start();
             CUDA_CHECK(cudaHostUnregister(host));
+            ggml_cuda_trace_span_end(GGML_CUDA_SPAN_PREFIX "host_unregister", nullptr, span_start, "bytes", (int64_t) size);
         }
     }
+
+    size_t size;
 };
 #endif
 
diff --git a/ggml/src/ggml-cuda/command-timing.cu b/ggml/src/ggml-cuda/command-timing.cu
index 6cfaf91d5..0de305871 100644
--- a/ggml/src/ggml-cuda/command-timing.cu
+++ b/ggml/src/ggml-cuda/command-timing.cu
@@ -2,12 +2,39 @@
 
 #include <atomic>
 #include <chrono>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
 
 static std::atomic<ggml_backend_command_timing_callback_t> g_timing_callback { nullptr };
 static std::atomic<void *> g_timing_user_data { nullptr };
 static std::atomic<uint32_t> g_timing_next_context_id { 0 };
 static thread_local uint64_t g_timing_tag = 0;
 
+static std::atomic<ggml_backend_trace_span_callback_t> g_span_callback { nullptr };
+static std::atomic<void *> g_span_user_data { nullptr };
+
+// spans that ended before the first span callback arrived, kept as Metal keeps them: weights can upload before anyone listens
+struct ggml_cuda_pending_span {
+    uint64_t     tag;
+    const char * name;
+    bool         has_detail;
+    std::string  detail;
+    int64_t      start_unix_ns;
+    int64_t      end_unix_ns;
+    const char * value_name;
+    int64_t      value;
+};
+
+static constexpr size_t GGML_CUDA_MAX_PENDING_SPANS = 256;
+
+static std::mutex g_pending_mutex;
+static std::vector<ggml_cuda_pending_span> g_pending_spans; // guarded by g_pending_mutex
+static std::atomic<bool> g_span_installed { false };
+// a process that never traces stops timing its copies once it has kept all it can
+static std::atomic<bool> g_pending_full { false };
+
 // a caller that never synchronizes loses its oldest computes past this
 static constexpr size_t GGML_CUDA_TIMING_MAX_PENDING = 1024;
 
@@ -26,9 +53,29 @@ static cudaEvent_t ggml_cuda_timing_take_event(ggml_backend_cuda_context & ctx)
     return event;
 }
 
-static void ggml_cuda_timing_recycle(ggml_backend_cuda_context & ctx, const ggml_cuda_timed_compute & compute) {
-    ctx.timing_free_events.push_back(compute.start);
-    ctx.timing_free_events.push_back(compute.end);
+static void ggml_cuda_timing_recycle(ggml_backend_cuda_context & ctx, cudaEvent_t start, cudaEvent_t end) {
+    ctx.timing_free_events.push_back(start);
+    ctx.timing_free_events.push_back(end);
+}
+
+static void ggml_cuda_trace_span_deliver(const ggml_backend_trace_span & span) {
+    if (!g_span_installed.load(std::memory_order_acquire)) {
+        std::lock_guard<std::mutex> lock(g_pending_mutex);
+        if (!g_span_installed.load(std::memory_order_acquire)) {
+            if (g_pending_spans.size() < GGML_CUDA_MAX_PENDING_SPANS) {
+                g_pending_spans.push_back({ span.tag, span.name, span.detail != nullptr,
+                        span.detail != nullptr ? span.detail : "", span.start_unix_ns, span.end_unix_ns,
+                        span.value_name, span.value });
+            }
+            g_pending_full.store(g_pending_spans.size() == GGML_CUDA_MAX_PENDING_SPANS, std::memory_order_relaxed);
+            return;
+        }
+    }
+    // installed, possibly while this span was ending
+    const auto callback = g_span_callback.load(std::memory_order_acquire);
+    if (callback != nullptr) {
+        callback(&span, g_span_user_data.load(std::memory_order_acquire));
+    }
 }
 
 void ggml_cuda_set_command_timing_callback(ggml_backend_command_timing_callback_t callback, void * user_data) {
@@ -40,6 +87,45 @@ void ggml_cuda_set_command_timing_tag(uint64_t tag) {
     g_timing_tag = tag;
 }
 
+void ggml_cuda_set_trace_span_callback(ggml_backend_trace_span_callback_t callback, void * user_data) {
+    if (callback == nullptr) {
+        g_span_callback.store(nullptr, std::memory_order_release);
+        return;
+    }
+
+    std::vector<ggml_cuda_pending_span> pending;
+    {
+        std::lock_guard<std::mutex> lock(g_pending_mutex);
+        g_span_user_data.store(user_data, std::memory_order_relaxed);
+        g_span_callback.store(callback, std::memory_order_release);
+        g_span_installed.store(true, std::memory_order_release);
+        pending.swap(g_pending_spans);
+    }
+
+    // kept spans reach the first callback in the order they ended
+    for (const auto & kept : pending) {
+        const ggml_backend_trace_span span = {
+            kept.tag, kept.name, kept.has_detail ? kept.detail.c_str() : nullptr,
+            kept.start_unix_ns, kept.end_unix_ns, kept.value_name, kept.value,
+        };
+        callback(&span, user_data);
+    }
+}
+
+int64_t ggml_cuda_trace_span_start() {
+    const bool unwanted = g_span_installed.load(std::memory_order_acquire)
+        ? g_span_callback.load(std::memory_order_acquire) == nullptr
+        : g_pending_full.load(std::memory_order_relaxed);
+    return unwanted ? 0 : ggml_cuda_timing_now_ns();
+}
+
+void ggml_cuda_trace_span_end(const char * name, const char * detail, int64_t start_unix_ns, const char * value_name, int64_t value) {
+    if (start_unix_ns == 0) {
+        return;
+    }
+    ggml_cuda_trace_span_deliver({ g_timing_tag, name, detail, start_unix_ns, ggml_cuda_timing_now_ns(), value_name, value });
+}
+
 void ggml_cuda_command_timing_begin(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph) {
     if (g_timing_callback.load(std::memory_order_acquire) == nullptr) {
         return;
@@ -67,21 +153,50 @@ void ggml_cuda_command_timing_end(ggml_backend_cuda_context & ctx) {
     CUDA_CHECK(cudaEventRecord(compute.end, ctx.stream()));
     compute.encode_end_ns = ggml_cuda_timing_now_ns();
     if (ctx.timing_pending.size() == GGML_CUDA_TIMING_MAX_PENDING) {
-        ggml_cuda_timing_recycle(ctx, ctx.timing_pending.front());
+        ggml_cuda_timing_recycle(ctx, ctx.timing_pending.front().start, ctx.timing_pending.front().end);
         ctx.timing_pending.erase(ctx.timing_pending.begin());
     }
     ctx.timing_pending.push_back(compute);
 }
 
+ggml_cuda_timed_copy ggml_cuda_copy_timing_begin(ggml_backend_cuda_context & ctx) {
+    ggml_cuda_timed_copy copy;
+    if (!g_span_installed.load(std::memory_order_acquire) || g_span_callback.load(std::memory_order_acquire) == nullptr) {
+        return copy;
+    }
+    // the async entry points do not select the device, and an event must be created on the stream's
+    ggml_cuda_set_device(ctx.device);
+    copy.start = ggml_cuda_timing_take_event(ctx);
+    CUDA_CHECK(cudaEventRecord(copy.start, ctx.stream()));
+    return copy;
+}
+
+void ggml_cuda_copy_timing_end(ggml_backend_cuda_context & ctx, ggml_cuda_timed_copy & copy, const char * name,
+        const ggml_tensor * tensor, size_t bytes) {
+    if (copy.start == nullptr) {
+        return;
+    }
+    copy.end = ggml_cuda_timing_take_event(ctx);
+    CUDA_CHECK(cudaEventRecord(copy.end, ctx.stream()));
+    copy.tag   = g_timing_tag;
+    copy.name  = name;
+    copy.bytes = bytes;
+    std::strncpy(copy.tensor, tensor->name, sizeof(copy.tensor) - 1);
+    if (ctx.timing_copies.size() == GGML_CUDA_TIMING_MAX_PENDING) {
+        ggml_cuda_timing_recycle(ctx, ctx.timing_copies.front().start, ctx.timing_copies.front().end);
+        ctx.timing_copies.erase(ctx.timing_copies.begin());
+    }
+    ctx.timing_copies.push_back(copy);
+}
+
 void ggml_cuda_command_timing_report(ggml_backend_cuda_context & ctx) {
-    if (ctx.timing_pending.empty()) {
+    if (ctx.timing_pending.empty() && ctx.timing_copies.empty()) {
         return;
     }
     const auto callback = g_timing_callback.load(std::memory_order_acquire);
     void * user_data = g_timing_user_data.load(std::memory_order_relaxed);
 
-    // a scheduler synchronizes each backend in turn without selecting its device, and an event
-    // created on another device cannot be recorded on this context's stream
+    // a scheduler synchronizes each backend without selecting its device, and an event from another device cannot be recorded on this stream
     ggml_cuda_set_device(ctx.device);
 
     // the stream is idle, so this event completes at once: it ties event times to the host clock
@@ -90,14 +205,23 @@ void ggml_cuda_command_timing_report(ggml_backend_cuda_context & ctx) {
     CUDA_CHECK(cudaEventSynchronize(now));
     const int64_t now_ns = ggml_cuda_timing_now_ns();
 
+    // the host-clock instants of an event pair, false when either was not timed
+    const auto window = [now, now_ns](cudaEvent_t start, cudaEvent_t end, int64_t & start_ns, int64_t & end_ns) {
+        float since_start_ms = 0.0f;
+        float since_end_ms   = 0.0f;
+        if (cudaEventElapsedTime(&since_start_ms, start, now) != cudaSuccess ||
+                cudaEventElapsedTime(&since_end_ms, end, now) != cudaSuccess) {
+            return false;
+        }
+        start_ns = now_ns - (int64_t) ((double) since_start_ms * 1e6);
+        end_ns   = now_ns - (int64_t) ((double) since_end_ms * 1e6);
+        return true;
+    };
+
     for (const ggml_cuda_timed_compute & compute : ctx.timing_pending) {
         if (callback != nullptr) {
-            float since_start_ms = 0.0f;
-            float since_end_ms   = 0.0f;
-            const bool timed = cudaEventElapsedTime(&since_start_ms, compute.start, now) == cudaSuccess &&
-                               cudaEventElapsedTime(&since_end_ms, compute.end, now) == cudaSuccess;
-
             ggml_backend_command_timing timing = {};
+            const bool timed = window(compute.start, compute.end, timing.execute_start_unix_ns, timing.execute_end_unix_ns);
             timing.tag           = compute.tag;
             timing.context_id    = ctx.timing_context_id;
             timing.compute_index = compute.compute_index;
@@ -107,16 +231,23 @@ void ggml_cuda_command_timing_report(ggml_backend_cuda_context & ctx) {
             timing.status        = timed ? 0 : 1;
             timing.encode_start_unix_ns = compute.encode_start_ns;
             timing.encode_end_unix_ns   = compute.encode_end_ns;
-            if (timed) {
-                timing.execute_start_unix_ns = now_ns - (int64_t) ((double) since_start_ms * 1e6);
-                timing.execute_end_unix_ns   = now_ns - (int64_t) ((double) since_end_ms * 1e6);
-            }
             timing.op_class = GGML_BACKEND_OP_CLASS_COUNT;
             timing.layer    = -1;
             callback(&timing, user_data);
         }
-        ggml_cuda_timing_recycle(ctx, compute);
+        ggml_cuda_timing_recycle(ctx, compute.start, compute.end);
     }
     ctx.timing_pending.clear();
+
+    for (const ggml_cuda_timed_copy & copy : ctx.timing_copies) {
+        int64_t start_ns = 0;
+        int64_t end_ns   = 0;
+        if (window(copy.start, copy.end, start_ns, end_ns)) {
+            ggml_cuda_trace_span_deliver({ copy.tag, copy.name, copy.tensor, start_ns, end_ns, "bytes", (int64_t) copy.bytes });
+        }
+        ggml_cuda_timing_recycle(ctx, copy.start, copy.end);
+    }
+    ctx.timing_copies.clear();
+
     ctx.timing_free_events.push_back(now);
 }
diff --git a/ggml/src/ggml-cuda/command-timing.cuh b/ggml/src/ggml-cuda/command-timing.cuh
index bf975c4ca..5c008394a 100644
--- a/ggml/src/ggml-cuda/command-timing.cuh
+++ b/ggml/src/ggml-cuda/command-timing.cuh
@@ -11,5 +11,12 @@ void ggml_cuda_set_command_timing_tag(uint64_t tag);
 void ggml_cuda_command_timing_begin(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph);
 void ggml_cuda_command_timing_end(ggml_backend_cuda_context & ctx);
 
+// The "ggml_backend_set_trace_span_callback" proc: copies, allocations, pool flushes and BLAS setup (see ggml_cuda_trace_span_start)
+void ggml_cuda_set_trace_span_callback(ggml_backend_trace_span_callback_t callback, void * user_data);
+
+// With a span callback installed, the async copy enqueued between begin and end is timed on the stream and reported as a span at the next synchronize
+ggml_cuda_timed_copy ggml_cuda_copy_timing_begin(ggml_backend_cuda_context & ctx);
+void ggml_cuda_copy_timing_end(ggml_backend_cuda_context & ctx, ggml_cuda_timed_copy & copy, const char * name, const ggml_tensor * tensor, size_t bytes);
+
 // call once the stream is synchronized
 void ggml_cuda_command_timing_report(ggml_backend_cuda_context & ctx);
diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index b97b199d3..c476eacc0 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1271,6 +1271,19 @@ const ggml_cuda_device_info & ggml_cuda_info();
 void ggml_cuda_set_device(int device);
 int ggml_cuda_get_device();
 
+// span names match the command timing's backend name, lowercased
+#if defined(GGML_USE_HIP)
+#define GGML_CUDA_SPAN_PREFIX "rocm."
+#elif defined(GGML_USE_MUSA)
+#define GGML_CUDA_SPAN_PREFIX "musa."
+#else
+#define GGML_CUDA_SPAN_PREFIX "cuda."
+#endif
+
+// Host-side backend work as trace spans: start returns 0 when no span is wanted, and end then does nothing
+int64_t ggml_cuda_trace_span_start();
+void ggml_cuda_trace_span_end(const char * name, const char * detail, int64_t start_unix_ns, const char * value_name = nullptr, int64_t value = 0);
+
 bool ggml_cuda_pool_debug_enabled();
 
 struct ggml_cuda_pool {
@@ -1352,6 +1365,15 @@ struct ggml_cuda_timed_compute {
     int64_t  encode_end_ns   = 0;
 };
 
+struct ggml_cuda_timed_copy {
+    cudaEvent_t start = nullptr;
+    cudaEvent_t end   = nullptr;
+    uint64_t     tag   = 0;
+    const char * name  = nullptr;
+    size_t       bytes = 0;
+    char         tensor[GGML_MAX_NAME] = {};
+};
+
 struct ggml_backend_cuda_context {
     int device;
     std::string name;
@@ -1395,6 +1417,7 @@ struct ggml_backend_cuda_context {
     uint32_t timing_compute_count = 0;
     std::vector<cudaEvent_t> timing_free_events;
     std::vector<ggml_cuda_timed_compute> timing_pending;
+    std::vector<ggml_cuda_timed_copy> timing_copies;
     ggml_cuda_timed_compute timing_open;
 
     ~ggml_backend_cuda_context();
@@ -1413,6 +1436,7 @@ struct ggml_backend_cuda_context {
 
     cublasHandle_t cublas_handle() {
         if (cublas_handles[device][curr_stream_no] == nullptr) {
+            const int64_t span_start = ggml_cuda_trace_span_start();
             ggml_cuda_set_device(device);
             CUBLAS_CHECK(cublasCreate(&cublas_handles[device][curr_stream_no]));
             CUBLAS_CHECK(cublasSetMathMode(cublas_handles[device][curr_stream_no], CUBLAS_TF32_TENSOR_OP_MATH));
@@ -1429,6 +1453,7 @@ struct ggml_backend_cuda_context {
             CUDA_CHECK(cudaMalloc(&cublas_workspaces[device][curr_stream_no], cublas_workspace_sizes[device]));
             CUBLAS_CHECK(cublasSetWorkspace(cublas_handles[device][curr_stream_no], cublas_workspaces[device][curr_stream_no], cublas_workspace_sizes[device]));
 #endif
+            ggml_cuda_trace_span_end(GGML_CUDA_SPAN_PREFIX "blas_init", nullptr, span_start);
         }
         return cublas_handles[device][curr_stream_no];
     }
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 1c413f727..0b59ec3c1 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -94,6 +94,7 @@
 #include <memory>
 #include <mutex>
 #include <new>
+#include <numeric>
 #include <cstdarg>
 #include <cstdio>
 #include <cstdlib>
@@ -198,7 +199,7 @@ static int ggml_cuda_op_offload_min_batch() {
     return min_batch;
 }
 
-static cudaError_t ggml_cuda_device_malloc(void ** ptr, size_t size, int device) {
+static cudaError_t ggml_cuda_device_malloc_untraced(void ** ptr, size_t size, int device) {
     ggml_cuda_set_device(device);
     cudaError_t err;
     if (ggml_cuda_unified_memory_enabled()) {
@@ -228,6 +229,14 @@ static cudaError_t ggml_cuda_device_malloc(void ** ptr, size_t size, int device)
     return err;
 }
 
+static cudaError_t ggml_cuda_device_malloc(void ** ptr, size_t size, int device) {
+    const int64_t span_start = ggml_cuda_trace_span_start();
+    const cudaError_t err = ggml_cuda_device_malloc_untraced(ptr, size, device);
+    const char * kind = err != cudaSuccess ? "failed" : ggml_cuda_unified_memory_enabled() ? "managed" : "device";
+    ggml_cuda_trace_span_end(GGML_CUDA_SPAN_PREFIX "buffer_alloc", kind, span_start, "bytes", (int64_t) size);
+    return err;
+}
+
 #if defined(GGML_USE_HIP)
 static int ggml_cuda_parse_id(const char * devName) {
     // A list of possible Target IDs can be found under the rocclr/clr repo in device.cpp
@@ -552,10 +561,12 @@ struct ggml_cuda_pool_leg : public ggml_cuda_pool {
             const size_t cached_bytes = pool_size;
             GGML_LOG_DEBUG(GGML_CUDA_NAME " pool[%d]: alloc of %.2f MiB failed, flushing %.2f MiB of cached buffers and retrying\n",
                            device, look_ahead_size/1024.0/1024.0, cached_bytes/1024.0/1024.0);
+            const int64_t span_start = ggml_cuda_trace_span_start();
             CUDA_CHECK(cudaDeviceSynchronize());
             clear_pool();
             invalidate_cuda_graphs();
             err = ggml_cuda_device_malloc(&ptr, look_ahead_size, device);
+            ggml_cuda_trace_span_end(GGML_CUDA_SPAN_PREFIX "pool_flush", nullptr, span_start, "bytes", (int64_t) cached_bytes);
             if (err == cudaSuccess) {
