+void grammar_eog_policy(skippy_model * model) {
+    for (const bool grammar : {false, true}) {
+        for (const bool ignore_eos : {false, true}) {
+            auto * session = create(model);
+            auto config = sampling_config();
+            config.ignore_eos = ignore_eos;
+            nlohmann::ordered_json metadata = nlohmann::ordered_json::object();
+            if (grammar) { metadata["grammar"] = "root ::= \"a\""; }
+            bool rejected = false;
+            try {
+                CHECK(skippy_initialize_chat_sampler(session, &config, metadata, nullptr));
+            } catch (const std::invalid_argument & error) {
+                rejected = std::string(error.what()).find("ignore_eos cannot be combined with a grammar") != std::string::npos;
+            }
+            CHECK(rejected == (grammar && ignore_eos));
+            release(session);
+        }
+    }
+}
