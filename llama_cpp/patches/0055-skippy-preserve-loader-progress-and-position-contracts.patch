+bool multi_axis_pages_require_lossless_positions(const llama_model & model) {
+    auto hparams = make_hparams(false);
+    hparams.rope_type = LLAMA_ROPE_TYPE_MROPE;
+    auto source = make_cache(model, hparams);
+    if (!populate(*source, page_token_count, true)) { return false; }
+    skippy_kv_page_desc desc{};
+    std::vector<uint8_t> payload;
+    std::string error;
+    if (!export_page(*source, page_token_count, desc, payload, error) ||
+            !(desc.flags & SKIPPY_KV_PAGE_FLAG_CANONICAL_POSITIONS)) { return false; }
+    auto target = make_cache(model, hparams);
+    auto unknown_positions = desc;
+    unknown_positions.flags &= ~uint64_t(SKIPPY_KV_PAGE_FLAG_CANONICAL_POSITIONS);
+    if (target->stage_import_kv_page(0, unknown_positions, payload.data(), payload.size(), error) ||
+            error.find("canonical secondary positions") == std::string::npos || target->seq_pos_max(0) != -1) {
+        return false;
+    }
+    bool unsupported = false, invalid = false;
+    if (target->stage_import_cachegen_kv_page(0, unknown_positions, nullptr, 0, 0,
+            error, unsupported, invalid, true) ||
+            error.find("canonical secondary positions") == std::string::npos || target->seq_pos_max(0) != -1) {
+        return false;
+    }
+    if (!target->stage_import_kv_page(0, desc, payload.data(), payload.size(), error)) { return false; }
+    skippy_kv_page_desc restored{};
+    std::vector<uint8_t> restored_payload;
+    if (!export_page(*target, page_token_count, restored, restored_payload, error) ||
+            restored.flags != desc.flags || restored_payload != payload) { return false; }
+    auto multimodal = make_cache(model, hparams);
+    if (!populate(*multimodal, page_token_count, true, true)) { return false; }
+    return !export_page(*multimodal, page_token_count, desc, payload, error) &&
+            error.find("differing secondary positions") != std::string::npos;
+}
