+                        std::printf("%-6s %-14s %6lld %6lld %12.2f %12.2f %8.1f %12.4g\n", r.kv, layout_name(r.value),
+                                (long long) r.rows, (long long) r.slices, r.gpu_us, r.wall_us, r.commands, r.checksum);
+                    }
