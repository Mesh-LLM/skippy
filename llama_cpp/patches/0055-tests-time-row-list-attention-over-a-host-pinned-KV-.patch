+        std::string memory = "device";
         for (int i = 1; i < argc; ++i) {
             if (std::strcmp(argv[i], "--backend") == 0 && i + 1 < argc) {
                 backend_name = argv[++i];
@@ -269,8 +288,11 @@ int main(int argc, char ** argv) {
                 iters = std::stoi(argv[++i]);
             } else if (std::strcmp(argv[i], "--depth") == 0 && i + 1 < argc) {
                 depth = std::stoi(argv[++i]);
+            } else if (std::strcmp(argv[i], "--kv-memory") == 0 && i + 1 < argc) {
+                memory = argv[++i];
+                require(memory == "device" || memory == "host" || memory == "both", "--kv-memory takes device, host or both");
             } else {
-                require(false, "usage: test-flash-attn-rows-perf [--backend NAME] [--iters N] [--depth N]");
+                require(false, "usage: test-flash-attn-rows-perf [--backend NAME] [--iters N] [--depth N] [--kv-memory device|host|both]");
             }
         }
         ggml_backend_load_all();
@@ -286,19 +308,32 @@ int main(int argc, char ** argv) {
         require(set_callback != nullptr, "backend reports no command timing; GPU time needs the Metal timing patch");
         set_callback(timing_sink::record, &sink);
 
-        std::printf("backend=%s dk=%lld dv=%lld heads=%lld kv_heads=%lld depth=%d iters=%d\n",
-                ggml_backend_name(backend.get()), (long long) dk, (long long) dv, (long long) heads,
-                (long long) kv_heads, depth, iters);
-        std::printf("%-14s %6s %6s %12s %12s %8s %12s\n", "layout", "rows", "slices", "gpu_us/call", "wall_us/call", "cmd/chain", "checksum");
+        ggml_backend_dev_t device = ggml_backend_get_device(backend.get());
+        std::vector<kv_memory> memories;
+        if (memory != "host") {
+            memories.push_back({"device", ggml_backend_get_default_buffer_type(backend.get())});
+        }
+        if (memory != "device") {
+            ggml_backend_buffer_type_t host = ggml_backend_dev_host_buffer_type(device);
+            require(host != nullptr, "the device has no host buffer type");
+            memories.push_back({"host", host});
+        }
+
+        std::printf("backend=%s device_type=%s dk=%lld dv=%lld heads=%lld kv_heads=%lld depth=%d iters=%d\n",
+                ggml_backend_name(backend.get()), ggml_backend_dev_type(device) == GGML_BACKEND_DEVICE_TYPE_IGPU ? "igpu" : "gpu",
+                (long long) dk, (long long) dv, (long long) heads, (long long) kv_heads, depth, iters);
+        std::printf("%-6s %-14s %6s %6s %12s %12s %8s %12s\n", "kv", "layout", "rows", "slices", "gpu_us/call", "wall_us/call", "cmd/chain", "checksum");
         for (int64_t slices : {1, 4}) {
             for (int64_t rows : {768, 4864}) {
                 for (layout value : {layout::dense, layout::identity, layout::chunk64, layout::stride, layout::padded, layout::tail, layout::split}) {
                     if (slices == 1 && (value == layout::chunk64 || value == layout::stride)) {
                         continue; // identical to identity with one slice
                     }
