-//   test-flash-attn-rows-perf [--backend NAME] [--iters N] [--depth N]
+//   test-flash-attn-rows-perf [--backend NAME] [--iters N] [--depth N] [--kv-memory device|host|both]
+//
+// --kv-memory places K and V in the device's own buffer type or in its pinned host buffer
+// type, the way GGML_CUDA_INTEGRATED keeps the cache on a GB10.
 //
 // GGML_METAL_CAPTURE_COMPUTE=N (with METAL_CAPTURE_ENABLED=1) captures one
 // chain for Xcode; a chain is small enough for the full Metal profiler.
@@ -103,9 +106,16 @@ struct timing_sink {
     }
 };
 
+struct kv_memory {
+    const char * name;
+    ggml_backend_buffer_type_t buft;
+};
+
