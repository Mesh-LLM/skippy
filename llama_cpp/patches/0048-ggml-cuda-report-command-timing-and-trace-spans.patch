diff --git a/ggml/src/ggml-cuda/timing.cu b/ggml/src/ggml-cuda/timing.cu
new file mode 100644
index 0000000..1ff408d
--- /dev/null
+++ b/ggml/src/ggml-cuda/timing.cu
@@ -0,0 +1,167 @@
+#include "timing.cuh"
+
+#include <algorithm>
+#include <memory>
+
+namespace {
+
+constexpr size_t  MAX_PENDING_COMMANDS = 1024;
+constexpr int64_t ANCHOR_RENEW_NS      = 1000000000;
+
+cudaEvent_t take_event(ggml_cuda_timing & timing) {
+    if (timing.spare.empty()) {
+        cudaEvent_t event = nullptr;
+        CUDA_CHECK(cudaEventCreateWithFlags(&event, cudaEventDefault));
+        return event;
+    }
+    const cudaEvent_t event = timing.spare.back();
+    timing.spare.pop_back();
+    return event;
+}
+
+void destroy_event(cudaEvent_t event) {
+    CUDA_CHECK(cudaEventDestroy(event));
+}
+
+void renew_anchor(ggml_cuda_timing & timing, cudaStream_t stream) {
+    if (timing.anchor == nullptr) {
+        CUDA_CHECK(cudaEventCreateWithFlags(&timing.anchor, cudaEventDefault));
+    }
+    CUDA_CHECK(cudaEventRecord(timing.anchor, stream));
+    CUDA_CHECK(cudaEventSynchronize(timing.anchor));
+    timing.anchor_unix_ns = ggml_backend_timing_unix_now_ns();
+}
+
+bool finished(const ggml_cuda_timing_command & command) {
+    if (cudaEventQuery(command.end) == cudaErrorNotReady) {
+        // HIP keeps "not ready" as the last error, which the next launch check would report
+        (void) cudaGetLastError();
+        return false;
+    }
+    return true;
+}
+
+int64_t unix_ns_at(const ggml_cuda_timing & timing, cudaEvent_t event) {
+    float ms = 0.0f;
+    if (cudaEventElapsedTime(&ms, timing.anchor, event) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return 0;
+    }
+    return timing.anchor_unix_ns + (int64_t) ((double) ms * 1e6);
+}
+
+void report(ggml_cuda_timing & timing, ggml_cuda_timing_command & command) {
+    const cudaError_t status = cudaEventQuery(command.end);
+    command.timing.status = (int32_t) status;
+    if (status == cudaSuccess) {
+        command.timing.execute_start_unix_ns = unix_ns_at(timing, command.start);
+        command.timing.execute_end_unix_ns   = unix_ns_at(timing, command.end);
+    } else {
+        (void) cudaGetLastError();
+    }
+    ggml_backend_timing_report(ggml_cuda_timing_hooks(), &command.timing);
+}
+
+} // namespace
+
+ggml_backend_timing_t ggml_cuda_timing_hooks() {
+    static const ggml_backend_timing_t hooks = ggml_backend_timing_new(GGML_CUDA_TIMING_PREFIX);
+    return hooks;
+}
+
+void ggml_cuda_timing_set_callback(ggml_backend_command_timing_callback_t callback, void * user_data) {
+    ggml_backend_timing_set_callback(ggml_cuda_timing_hooks(), callback, user_data);
+}
+
+void ggml_cuda_timing_set_tag(uint64_t tag) {
+    ggml_backend_timing_set_tag(tag);
+}
+
+void ggml_cuda_timing_set_span_callback(ggml_backend_trace_span_callback_t callback, void * user_data) {
+    ggml_backend_timing_set_span_callback(ggml_cuda_timing_hooks(), callback, user_data);
+}
+
+ggml_cuda_timing_span::ggml_cuda_timing_span(const char * name, const char * detail) :
+    name(name), detail(detail), start_unix_ns(ggml_backend_timing_span_start(ggml_cuda_timing_hooks())) {}
+
+ggml_cuda_timing_span::~ggml_cuda_timing_span() {
+    ggml_backend_timing_span_end(ggml_cuda_timing_hooks(), name, detail, start_unix_ns);
+}
+
+ggml_cuda_timing::ggml_cuda_timing(int device) : device(device), context_id(ggml_backend_timing_next_context_id()) {}
+
+ggml_cuda_timing::~ggml_cuda_timing() {
+    ggml_cuda_set_device(device);
+    std::for_each(pending.begin(), pending.end(), [](const ggml_cuda_timing_command & command) {
+        destroy_event(command.start);
+        destroy_event(command.end);
+    });
+    std::for_each(spare.begin(), spare.end(), destroy_event);
+    if (anchor != nullptr) {
+        destroy_event(anchor);
+    }
+}
+
+void ggml_cuda_timing_collect(ggml_backend_cuda_context & ctx, bool synchronized) {
+    if (!ctx.timing) {
+        return;
+    }
+    ggml_cuda_timing & timing = *ctx.timing;
+
+    const auto done = std::find_if_not(timing.pending.begin(), timing.pending.end(), finished);
+    const bool reporting = ggml_backend_timing_commands_enabled(ggml_cuda_timing_hooks());
+    std::for_each(timing.pending.begin(), done, [&timing, reporting](ggml_cuda_timing_command & command) {
+        if (reporting) {
+            report(timing, command);
+        }
+        timing.spare.push_back(command.start);
+        timing.spare.push_back(command.end);
+    });
+    timing.pending.erase(timing.pending.begin(), done);
+
+    if (synchronized && reporting && timing.pending.empty() &&
+            ggml_backend_timing_unix_now_ns() - timing.anchor_unix_ns > ANCHOR_RENEW_NS) {
+        renew_anchor(timing, ctx.stream(ctx.device, 0));
+    }
+}
+
+ggml_cuda_timing_compute::ggml_cuda_timing_compute(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph) : ctx(ctx) {
+    ggml_backend_timing_t hooks = ggml_cuda_timing_hooks();
+    if (!ggml_backend_timing_commands_enabled(hooks)) {
+        return;
+    }
+    if (!ctx.timing) {
+        ctx.timing = std::make_unique<ggml_cuda_timing>(ctx.device);
+    }
+    ggml_cuda_timing & timing = *ctx.timing;
+    timing.compute_index++;
+
+    ggml_cuda_timing_collect(ctx, false);
+    if (timing.pending.size() >= MAX_PENDING_COMMANDS) {
+        return;
+    }
+
+    cudaStream_t stream = ctx.stream(ctx.device, 0);
+    if (timing.anchor == nullptr) {
+        renew_anchor(timing, stream);
+    }
+    ggml_backend_timing_graph_ops(hooks, cgraph);
+
+    command.emplace();
+    ggml_backend_timing_command_init(&command->timing, timing.context_id, timing.compute_index, 0, 1, (uint32_t) cgraph->n_nodes);
+    ggml_backend_timing_account(&command->timing, cgraph, 0, cgraph->n_nodes, false);
+    command->start = take_event(timing);
+    command->end   = take_event(timing);
+
+    command->timing.encode_start_unix_ns = ggml_backend_timing_unix_now_ns();
+    CUDA_CHECK(cudaEventRecord(command->start, stream));
+}
+
+ggml_cuda_timing_compute::~ggml_cuda_timing_compute() {
+    if (!command) {
+        return;
+    }
+    CUDA_CHECK(cudaEventRecord(command->end, ctx.stream(ctx.device, 0)));
+    command->timing.encode_end_unix_ns = ggml_backend_timing_unix_now_ns();
+    ctx.timing->pending.push_back(*command);
+}
diff --git a/ggml/src/ggml-cuda/timing.cuh b/ggml/src/ggml-cuda/timing.cuh
new file mode 100644
index 0000000..a60d7cd
--- /dev/null
+++ b/ggml/src/ggml-cuda/timing.cuh
@@ -0,0 +1,78 @@
+#pragma once
+
+#include "common.cuh"
+
+#include "../ggml-backend-timing.h"
+
+#include <deque>
+#include <optional>
+#include <vector>
+
+#if defined(GGML_USE_HIP)
+#define GGML_CUDA_TIMING_PREFIX "rocm"
+#elif defined(GGML_USE_MUSA)
+#define GGML_CUDA_TIMING_PREFIX "musa"
+#else
+#define GGML_CUDA_TIMING_PREFIX "cuda"
+#endif
+
+ggml_backend_timing_t ggml_cuda_timing_hooks();
+
+void ggml_cuda_timing_set_callback(ggml_backend_command_timing_callback_t callback, void * user_data);
+void ggml_cuda_timing_set_tag(uint64_t tag);
+void ggml_cuda_timing_set_span_callback(ggml_backend_trace_span_callback_t callback, void * user_data);
+
+// `name` is static; `detail` must outlive the span
+struct ggml_cuda_timing_span {
+    ggml_cuda_timing_span(const char * name, const char * detail);
+    ~ggml_cuda_timing_span();
+
+    ggml_cuda_timing_span(const ggml_cuda_timing_span &)             = delete;
+    ggml_cuda_timing_span & operator=(const ggml_cuda_timing_span &) = delete;
+
+private:
+    const char * name;
+    const char * detail;
+    int64_t      start_unix_ns;
+};
+
+// events on the context's main stream, recorded outside CUDA graph capture
+struct ggml_cuda_timing_command {
+    ggml_backend_command_timing timing;
+    cudaEvent_t                 start;
+    cudaEvent_t                 end;
+};
+
+struct ggml_cuda_timing {
+    explicit ggml_cuda_timing(int device);
+    ~ggml_cuda_timing();
+
+    ggml_cuda_timing(const ggml_cuda_timing &)             = delete;
+    ggml_cuda_timing & operator=(const ggml_cuda_timing &) = delete;
+
+    const int      device;
+    const uint32_t context_id;
+    uint32_t       compute_index = 0;
+
+    // owns every event below
+    std::deque<ggml_cuda_timing_command> pending;
+    std::vector<cudaEvent_t>             spare;
+
+    // event times reach the Unix clock through the anchor, read when the host saw it complete
+    cudaEvent_t anchor         = nullptr;
+    int64_t     anchor_unix_ns = 0;
+};
+
+struct ggml_cuda_timing_compute {
+    ggml_cuda_timing_compute(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph);
+    ~ggml_cuda_timing_compute();
+
+    ggml_cuda_timing_compute(const ggml_cuda_timing_compute &)             = delete;
+    ggml_cuda_timing_compute & operator=(const ggml_cuda_timing_compute &) = delete;
+
+private:
+    ggml_backend_cuda_context &              ctx;
+    std::optional<ggml_cuda_timing_command> command;
+};
+
+void ggml_cuda_timing_collect(ggml_backend_cuda_context & ctx, bool synchronized);
