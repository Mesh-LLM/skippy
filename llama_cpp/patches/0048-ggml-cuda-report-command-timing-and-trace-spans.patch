new file mode 100644
index 0000000..e43b5b9
--- /dev/null
+++ b/tests/test-skippy-tracing-cuda.cpp
@@ -0,0 +1,158 @@
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cuda.h"
+#include "ggml.h"
+#include "skippy/common.h"
+#include "skippy/tracing.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#define CHECK(cond)                                                     \
+    do {                                                                \
+        if (!(cond)) {                                                  \
+            std::fprintf(stderr, "%s:%d: CHECK(%s)\n", __FILE__, __LINE__, #cond); \
+            return 1;                                                   \
+        }                                                               \
+    } while (0)
+
+namespace {
+
+constexpr uint64_t TAG = 0xc0da;
+
+struct received_span {
+    std::string name;
+    uint64_t    parent;
+    int64_t     start_unix_ns;
+    int64_t     end_unix_ns;
+};
+
+std::mutex                                g_mutex;
+std::vector<skippy_gpu_command_timing_v1> g_received;
+std::vector<received_span>                g_spans;
+
+void receive(const skippy_gpu_command_timing_v1 * timing, void *) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_received.push_back(*timing);
+}
+
+void receive_span(const skippy_native_span_v1 * span, void *) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_spans.push_back({ span->name, span->parent, span->start_unix_ns, span->end_unix_ns });
+}
+
+bool has_span(const char * name, uint64_t parent) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    return std::any_of(g_spans.begin(), g_spans.end(), [&](const received_span & span) {
+        return span.name == name && span.parent == parent && span.start_unix_ns <= span.end_unix_ns;
+    });
+}
+
+int64_t unix_now_ns() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+#define EXPECT(cond)                                                    \
+    do {                                                                \
+        if (!(cond)) {                                                  \
+            std::fprintf(stderr, "%s:%d: EXPECT(%s)\n", __FILE__, __LINE__, #cond); \
+            return false;                                               \
+        }                                                               \
+    } while (0)
+
+bool valid(const skippy_gpu_command_timing_v1 & t, const char * backend_name, int64_t submitted_ns, int64_t returned_ns) {
+    std::fprintf(stderr, "timing: compute=%u nodes=%u class=%s encode=%lldns execute=%lldns\n",
+            t.compute_index, t.node_count, t.op_class,
+            (long long) (t.encode_end_unix_ns - t.encode_start_unix_ns),
+            (long long) (t.execute_end_unix_ns - t.execute_start_unix_ns));
+    EXPECT(t.tag == TAG);
+    EXPECT(std::strcmp(t.backend_name, backend_name) == 0);
+    EXPECT(t.status == 0);
+    EXPECT(t.command_index == 0 && t.command_count == 1);
+    EXPECT(std::strcmp(t.op_class, "other") == 0);
+    EXPECT(t.other_nodes == 2);
+    EXPECT(t.attention_nodes == 0 && t.matmul_nodes == 0 && t.recurrent_nodes == 0 && t.kv_write_nodes == 0);
+    EXPECT(t.layer == -1);
+    EXPECT(t.encode_start_unix_ns >= submitted_ns && t.encode_start_unix_ns <= t.encode_end_unix_ns);
+    EXPECT(t.execute_start_unix_ns > 0 && t.execute_start_unix_ns <= t.execute_end_unix_ns);
+    EXPECT(t.execute_start_unix_ns >= t.encode_start_unix_ns - 1000000);
+    EXPECT(t.execute_end_unix_ns <= returned_ns + 1000000);
+    return true;
+}
+
+} // namespace
+
+int main() {
+    if (ggml_backend_cuda_get_device_count() == 0) {
+        std::fprintf(stderr, "no CUDA device; skipping\n");
+        return 0;
+    }
+    ggml_backend_t backend = ggml_backend_cuda_init(0);
+    CHECK(backend != nullptr);
+
+    CHECK(skippy_set_native_span_callback(receive_span, nullptr) == SKIPPY_STATUS_OK);
+    CHECK(skippy_set_gpu_command_timing_callback(receive, nullptr) == SKIPPY_STATUS_OK);
+
+    ggml_init_params params = { ggml_tensor_overhead() * 8 + ggml_graph_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(params);
+    CHECK(ctx != nullptr);
+    ggml_tensor * a = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 4096);
+    ggml_tensor * b = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 4096);
+    ggml_tensor * c = ggml_add(ctx, ggml_mul(ctx, a, b), b);
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, c);
+
+    ggml_backend_buffer_t buffer = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    CHECK(buffer != nullptr);
+    const std::vector<float> ones(4096, 1.0f);
+    ggml_backend_tensor_set(a, ones.data(), 0, ggml_nbytes(a));
+    ggml_backend_tensor_set(b, ones.data(), 0, ggml_nbytes(b));
+
+    std::vector<ggml_status> statuses(3);
+    const int64_t submitted_ns = unix_now_ns();
+    skippy_set_trace_tag(TAG);
+    std::generate(statuses.begin(), statuses.end(), [&] { return ggml_backend_graph_compute(backend, gf); });
+    std::vector<float> result(4096, 0.0f);
+    ggml_backend_tensor_get(c, result.data(), 0, ggml_nbytes(c));
+    skippy_set_trace_tag(0);
+    const int64_t returned_ns = unix_now_ns();
+
+    CHECK(std::all_of(statuses.begin(), statuses.end(), [](ggml_status s) { return s == GGML_STATUS_SUCCESS; }));
+    CHECK(result[0] == 2.0f);
+    CHECK(has_span("cuda.upload", 0));
+    CHECK(has_span("cuda.wait", TAG));
+    CHECK(has_span("cuda.download", TAG));
+    CHECK(has_span("cuda.graph_ops", TAG));
+    std::fprintf(stderr, "graph capture span: %s\n", has_span("cuda.graph_capture", TAG) ? "yes" : "no");
+
+    std::vector<skippy_gpu_command_timing_v1> received;
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        received = g_received;
+    }
+    CHECK(received.size() == statuses.size());
+
+    const char * backend_name = ggml_backend_reg_name(ggml_backend_cuda_reg());
+    CHECK(std::all_of(received.begin(), received.end(), [&](const skippy_gpu_command_timing_v1 & t) {
+        return valid(t, backend_name, submitted_ns, returned_ns);
+    }));
+    CHECK(std::adjacent_find(received.begin(), received.end(), [](const auto & earlier, const auto & later) {
+        return later.compute_index <= earlier.compute_index;
+    }) == received.end());
+
+    CHECK(skippy_set_gpu_command_timing_callback(nullptr, nullptr) == SKIPPY_STATUS_OK);
+    CHECK(skippy_set_native_span_callback(nullptr, nullptr) == SKIPPY_STATUS_OK);
+    ggml_backend_buffer_free(buffer);
+    ggml_free(ctx);
+    ggml_backend_free(backend);
+
+    std::printf("ok: %zu graph compute(s)\n", received.size());
+    return 0;
+}
