+// A lane whose cell holds its state outright, with no rollback pending, shares
+// the cell with the cache sequence while a resident cell is free; otherwise the
+// state is copied to host memory.
+void capture_recurrent(skippy_session * session, llama_memory_recurrent & recurrent, int32_t cache_seq_id,
+        skippy_resident_checkpoint & checkpoint) {
+    const auto lane = static_cast<size_t>(session->seq_id);
+    auto & model = *session->stage_model;
+    recurrent_buffer_writer measure;
+    recurrent.state_write(measure, session->seq_id, LLAMA_STATE_SEQ_FLAGS_NONE);
+    const bool whole_cell = lane < recurrent.tails.size() && recurrent.tails[lane] >= 0
+            && lane < recurrent.rs_idx.size() && recurrent.rs_idx[lane] == 0
+            && static_cast<size_t>(cache_seq_id) < recurrent.tails.size();
+    if (whole_cell && model.resident_cells.take()) {
+        checkpoint.recurrent = skippy_resident_cell{measure.n_bytes()};
+        recurrent.seq_cp(session->seq_id, cache_seq_id, -1, -1);
+        return;
+    }
+    model.resident_host_pool.use_type(checkpoint_host_type(recurrent));
+    auto & bytes = std::get<skippy_checkpoint_bytes>(checkpoint.recurrent);
+    bytes.resize(measure.n_bytes());
+    auto writer = llama_io_write_host_create(bytes.data(), bytes.size());
+    recurrent.state_write(*writer, session->seq_id, LLAMA_STATE_SEQ_FLAGS_NONE);
+    if (writer->n_bytes() != bytes.size()) {
+        throw std::runtime_error("resident recurrent checkpoint size changed during capture");
+    }
+    // Upstream's host writer defers tensor reads until destruction.
+    // Finish them while the destination and resident owner are stable,
+    // before publishing either the checkpoint or its attention alias.
+    writer.reset();
+}
+
+// The cache sequence leaves its cell, which stays the lane's until the lane moves on.
+void release_recurrent(skippy_model & model, llama_memory_recurrent * recurrent, int32_t cache_seq_id,
+        const skippy_resident_checkpoint & checkpoint) {
+    if (!std::holds_alternative<skippy_resident_cell>(checkpoint.recurrent)) { return; }
+    if (recurrent) { recurrent->seq_rm(cache_seq_id, -1, -1); }
+    model.resident_cells.give();
+}
+
+// what exporting the checkpoint writes
+size_t recurrent_size(const skippy_resident_recurrent & recurrent) {
+    if (const auto * cell = std::get_if<skippy_resident_cell>(&recurrent)) { return cell->bytes; }
+    return std::get<skippy_checkpoint_bytes>(recurrent).size();
+}
+
+// what the checkpoint keeps allocated, so a cell counts as the copy it replaces
+size_t recurrent_held_bytes(const skippy_resident_recurrent & recurrent) {
+    if (const auto * cell = std::get_if<skippy_resident_cell>(&recurrent)) { return cell->bytes; }
+    return std::get<skippy_checkpoint_bytes>(recurrent).capacity();
+}
+
