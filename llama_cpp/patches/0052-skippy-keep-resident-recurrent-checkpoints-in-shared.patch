+// The recurrent cell the cache sequence shares with the lane that saved it,
+// owned by the recurrent memory; bytes is what exporting it writes.
+struct skippy_resident_cell {
+    size_t bytes = 0;
+};
+
+using skippy_resident_recurrent = std::variant<skippy_checkpoint_bytes, skippy_resident_cell>;
+
+// Recurrent cells beyond the lanes' own (n_rs_resident). A checkpoint in a cell
+// holds one, so a lane leaving a shared cell always finds a free one.
+class skippy_resident_cells {
+public:
+    skippy_resident_cells() = default;
+    explicit skippy_resident_cells(uint32_t capacity) : capacity(capacity) {}
+
+    bool take() {
+        if (held == capacity) { return false; }
+        ++held;
+        return true;
+    }
+    void give() noexcept {
+        GGML_ASSERT(held > 0);
+        --held;
+    }
+
+private:
+    uint32_t capacity = 0;
+    uint32_t held = 0;
+};
+
 // Cache-owned checkpoints outlive execution lanes. Attention remains in the
-// native shared cell pool; only the fixed-size recurrent component is copied.
+// native shared cell pool; the recurrent component is a copy or a cell.
 struct skippy_resident_checkpoint {
     std::vector<llama_token> tokens;
-    skippy_checkpoint_bytes recurrent;
+    skippy_resident_recurrent recurrent;
 };
 
