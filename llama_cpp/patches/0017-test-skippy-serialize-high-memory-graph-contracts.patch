From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Tue, 17 Nov 2026 23:20:00 +1100
Subject: [PATCH] test(skippy): serialize high-memory graph contracts

Keep two-way CTest concurrency for the native suite while preventing the two
production-sized graph contracts from overlapping with another test inside a
bounded CI runner.

---
 src/skippy/tests/graph_contract_cases.cmake | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/skippy/tests/graph_contract_cases.cmake b/src/skippy/tests/graph_contract_cases.cmake
index 725b75ad2..f0c8785c3 100644
--- a/src/skippy/tests/graph_contract_cases.cmake
+++ b/src/skippy/tests/graph_contract_cases.cmake
@@ -25,6 +25,13 @@ skippy_contract_case(kimi-linear kimi-linear 27 2304 0 causal)
 skippy_contract_case(qwen3-next qwen3next 48 2048 0 causal)
 skippy_contract_case(qwen4exp qwen4exp 48 10240 0 causal)
 skippy_contract_case(nemotron nemotron_h_moe 52 2688 1 causal)
+# These two production-sized graphs each fit the bounded CI runner alone, but
+# exceed its memory limit when they overlap. Account for both CTest slots so
+# the rest of the suite retains two-way parallelism without an OOM kill here.
+set_tests_properties(
+    skippy_graph_contract_qwen4exp
+    skippy_graph_contract_nemotron
+    PROPERTIES PROCESSORS 2)
 skippy_contract_case(mamba mamba 24 768 0 causal)
 skippy_contract_case(mamba2 mamba 64 4096 0 causal)
 skippy_contract_case(rwkv6 rwkv6 24 2048 0 causal)
-- 
2.50.1

