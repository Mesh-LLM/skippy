From 4200c28c2c31e36ae72fb19f6a19d98c78b849c8 Mon Sep 17 00:00:00 2001
From: James Dumay <james@generalinference.xyz>
Date: Sat, 28 Nov 2026 05:14:59 +1100
Subject: [PATCH] cachegen: decode F32 anchor-delta pages on GPU

---
 ggml/src/ggml-cuda/cachegen.cu             | 32 ++++++++++++++++++++
 ggml/src/ggml-cuda/ggml-cuda.cu            | 35 ++++++++++++++--------
 ggml/src/ggml-metal/ggml-metal-device.m    | 32 +++++++++++++-------
 ggml/src/ggml-metal/kernels/cachegen.metal | 32 ++++++++++++++++++++
 src/llama-kv-cache.cpp                     | 28 +++++++++++++++--
 5 files changed, 135 insertions(+), 24 deletions(-)

diff --git a/ggml/src/ggml-cuda/cachegen.cu b/ggml/src/ggml-cuda/cachegen.cu
index 394c1d45e..2dbcab02c 100644
--- a/ggml/src/ggml-cuda/cachegen.cu
+++ b/ggml/src/ggml-cuda/cachegen.cu
@@ -68,6 +68,38 @@ static __global__ void cachegen_decode(
 
     const ggml_cuda_cachegen_tile tile = tiles[tile_index];
     const uint8_t * segment            = payload + tile.payload_offset;
+    if (segment[0] == 'C' && segment[1] == 'G' && segment[2] == 'P' && segment[3] == '1') {
+        const float * row_maxes = reinterpret_cast<const float *>(segment + 16);
+        const uint8_t * symbols = segment + 16 + tile.rows * sizeof(float);
+        float anchor = 0.0f;
+        for (uint32_t row = 0; row < tile.rows; ++row) {
+            const uint32_t position = row % 10;
+            const uint32_t width = segment[13] == 16 ? 16 : (position == 0 ? 8 : 12);
+            const uint32_t preceding = segment[13] == 16 ? position * 16 : (position == 0 ? 0 : 8 + (position - 1) * 12);
+            const uint64_t symbol_bit =
+                (uint64_t(row / 10) * (segment[13] == 16 ? 160 : 116) + preceding) * channels + uint64_t(channel) * width;
+            const uint64_t byte_index = symbol_bit >> 3;
+            const uint32_t shift = symbol_bit & 7;
+            uint32_t word = uint32_t(symbols[byte_index]);
+            if (shift + width > 8) {
+                word |= uint32_t(symbols[byte_index + 1]) << 8;
+            }
+            if (shift + width > 16) {
+                word |= uint32_t(symbols[byte_index + 2]) << 16;
+            }
+            const uint32_t symbol = (word >> shift) & ((1u << width) - 1);
+            const float center = width == 16 ? 32767.0f : (position == 0 ? 127.0f : 2047.0f);
+            const float decoded = (float(symbol) - center) / center * row_maxes[row];
+            if (position == 0) {
+                anchor = decoded;
+            }
+            const float value = position == 0 ? decoded : anchor + decoded;
+            const uint64_t destination = uint64_t(cells[tile.token_offset + row]) * token_stride +
+                uint64_t(channel) * channel_stride;
+            *reinterpret_cast<float *>(dst + destination) = value;
+        }
+        return;
+    }
     const uint32_t bins                = segment[4];
     const bool packed                  = segment[3] == '2';
     const float * maxes                = reinterpret_cast<const float *>(segment + 16);
