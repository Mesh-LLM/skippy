+            error = "CacheGen anchor-delta segment header is invalid";
+            return false;
+        }
+        const size_t anchors = (expected_rows + group_rows - 1) / group_rows;
+        const size_t bits_per_channel = anchors * (delta_bits == 16 ? 16 : 8) +
+            (expected_rows - anchors) * delta_bits;
+        const size_t stream_bytes = (expected_channels * bits_per_channel + 7) / 8;
+        if (skippy_cachegen_read_u32(payload + 8) != stream_bytes ||
+            stream_bytes != record.payload_bytes - header_bytes - max_bytes) {
+            error = "CacheGen anchor-delta stream length is inconsistent";
+            return false;
+        }
+        return true;
+    }
     const size_t stream_bytes = skippy_cachegen_read_u32(payload + 12);
     if (packed) {
         const size_t values = expected_rows * expected_channels;
