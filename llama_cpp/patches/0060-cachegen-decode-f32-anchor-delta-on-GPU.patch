-                if ((!packed && memcmp(payload, "LCG1", 4) != 0) || (bins != 16 && bins != 32) ||
-                        (packed ? payload[5] != expected_bits : payload[5] != 0) ||
+                const uint32_t header_rows = paper ?
+                    (static_cast<uint32_t>(payload[4]) | static_cast<uint32_t>(payload[5]) << 8) :
+                    (static_cast<uint32_t>(payload[6]) | static_cast<uint32_t>(payload[7]) << 8);
+                const uint32_t header_channels = paper ?
+                    (static_cast<uint32_t>(payload[6]) | static_cast<uint32_t>(payload[7]) << 8) :
+                    (static_cast<uint32_t>(payload[8]) | static_cast<uint32_t>(payload[9]) << 8 |
+                     static_cast<uint32_t>(payload[10]) << 16 | static_cast<uint32_t>(payload[11]) << 24);
+                if ((paper ?
+                        (job->dst->type != GGML_TYPE_F32 || payload[12] != 10 || (payload[13] != 12 && payload[13] != 16) ||
+                         payload[14] != 0 || payload[15] != 0) :
+                        ((!packed && memcmp(payload, "LCG1", 4) != 0) || (bins != 16 && bins != 32) ||
+                         (packed ? payload[5] != expected_bits : payload[5] != 0))) ||
                         header_rows != tile->token_count || header_channels != job->channels) {
                     return ggml_cuda_cachegen_error(
                         error, error_capacity, "CUDA/HIP CacheGen tile header is inconsistent");
@@ -7220,13 +7226,18 @@ static bool ggml_cuda_cachegen_decode(
                     tile->token_offset,
                     tile->token_count,
                 };
-                const uint32_t declared_stream_bytes = static_cast<uint32_t>(payload[12]) |
-                    static_cast<uint32_t>(payload[13]) << 8 | static_cast<uint32_t>(payload[14]) << 16 |
-                    static_cast<uint32_t>(payload[15]) << 24;
+                const uint32_t declared_stream_bytes = paper ?
+                    (static_cast<uint32_t>(payload[8]) | static_cast<uint32_t>(payload[9]) << 8 |
+                     static_cast<uint32_t>(payload[10]) << 16 | static_cast<uint32_t>(payload[11]) << 24) :
+                    (static_cast<uint32_t>(payload[12]) | static_cast<uint32_t>(payload[13]) << 8 |
+                     static_cast<uint32_t>(payload[14]) << 16 | static_cast<uint32_t>(payload[15]) << 24);
                 staged.prefixes.push_back(0);
                 if (packed) {
                     const uint64_t values = static_cast<uint64_t>(tile->token_count) * job->channels;
-                    const uint64_t expected_stream_bytes = (values * expected_bits + 7) / 8;
