diff --git a/ggml/src/ggml-metal/kernels/cachegen.metal b/ggml/src/ggml-metal/kernels/cachegen.metal
index 728899e4b..dbb715f2a 100644
--- a/ggml/src/ggml-metal/kernels/cachegen.metal
+++ b/ggml/src/ggml-metal/kernels/cachegen.metal
@@ -70,6 +70,38 @@ kernel void kernel_cachegen_decode(const device uchar *         payload [[buffer
 
     const cachegen_tile   tile    = tiles[tile_index];
     const device uchar *  segment = payload + tile.payload_offset;
+    if (segment[0] == 'C' && segment[1] == 'G' && segment[2] == 'P' && segment[3] == '1') {
+        const device float * row_maxes = reinterpret_cast<const device float *>(segment + 16);
+        const device uchar * symbols = segment + 16 + tile.rows * sizeof(float);
+        float anchor = 0.0f;
+        for (uint row = 0; row < tile.rows; ++row) {
+            const uint position = row % 10;
+            const uint width = segment[13] == 16 ? 16 : (position == 0 ? 8 : 12);
+            const uint preceding = segment[13] == 16 ? position * 16 : (position == 0 ? 0 : 8 + (position - 1) * 12);
+            const ulong symbol_bit =
+                (ulong(row / 10) * (segment[13] == 16 ? 160ul : 116ul) + ulong(preceding)) * params.channels + ulong(channel) * width;
+            const ulong byte_index = symbol_bit >> 3;
+            const uint shift = symbol_bit & 7;
+            uint word = uint(symbols[byte_index]);
+            if (shift + width > 8) {
+                word |= uint(symbols[byte_index + 1]) << 8;
+            }
+            if (shift + width > 16) {
+                word |= uint(symbols[byte_index + 2]) << 16;
+            }
+            const uint symbol = (word >> shift) & ((1u << width) - 1);
+            const float center = width == 16 ? 32767.0f : (position == 0 ? 127.0f : 2047.0f);
+            const float decoded = (float(symbol) - center) / center * row_maxes[row];
+            if (position == 0) {
+                anchor = decoded;
+            }
+            const float value = position == 0 ? decoded : anchor + decoded;
+            const ulong destination = ulong(cells[tile.token_offset + row]) * params.token_stride +
+                ulong(channel) * params.channel_stride;
+            *reinterpret_cast<device float *>(dst + destination) = value;
+        }
+        return;
+    }
     const uint            bins    = segment[4];
     const bool            packed  = segment[3] == '2';
     const device float *  maxes   = reinterpret_cast<const device float *>(segment + 16);
