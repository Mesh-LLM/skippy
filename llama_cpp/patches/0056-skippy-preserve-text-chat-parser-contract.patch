From f1b083b9bb2bf83636ffb810563b4a7efb4ef4a0 Mon Sep 17 00:00:00 2001
From: Skippy CI <ci@skippy.local>
Date: Wed, 25 Nov 2026 13:04:07 +1100
Subject: [PATCH] skippy: keep the text chat bridge compatible with token-aware
 parsers

---
 common/stage-chat.cpp      |   2 +
 tests/CMakeLists.txt       |   5 ++
 tests/test-skippy-chat.cpp | 101 +++++++++++++++++++++++++++++++++++++
 3 files changed, 108 insertions(+)
 create mode 100644 tests/test-skippy-chat.cpp

diff --git a/common/stage-chat.cpp b/common/stage-chat.cpp
index c3362e2a7..d357342da 100644
--- a/common/stage-chat.cpp
+++ b/common/stage-chat.cpp
@@ -276,6 +276,8 @@ extern "C" SKIPPY_COMMON_API enum skippy_status skippy_apply_chat_template_json(
             throw std::runtime_error("failed to initialize model chat templates");
         }
         skippy_chat_templates_lock_guard templates_lock(model);
+        // This ABI carries text, not sampled token IDs. Keep its parser and grammar text-based.
+        common_chat_templates_set_specials(tmpls, {});
         common_chat_params params = common_chat_templates_apply(tmpls, inputs);
         if (grammar != nullptr && grammar[0] != '\0') {
             params.grammar = grammar;
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index e6bf3aa41..0d5df5901 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -349,6 +349,11 @@ llama_test_cmd(python3
 llama_build_and_test(test-json-schema.cpp  LABEL behavior)
 llama_build_and_test(test-chat-auto-parser.cpp  LABEL behavior  WORKING_DIRECTORY ${PROJECT_SOURCE_DIR})
 llama_build_and_test(test-chat-template.cpp  LABEL behavior)
+if (NOT WIN32 OR NOT BUILD_SHARED_LIBS)
+    llama_build_and_test(test-skippy-chat.cpp LABEL behavior
