From bdecd9d73a4f04ba0b5ca0f8f9942f09aab7632c Mon Sep 17 00:00:00 2001
From: Skippy CI <ci@skippy.local>
Date: Wed, 25 Nov 2026 07:49:52 +1100
Subject: [PATCH] cache: restore composite attention occupancy reporting

---
 src/skippy/resident_prefix.cpp | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/src/skippy/resident_prefix.cpp b/src/skippy/resident_prefix.cpp
index 317c96b46..57b1d78ac 100644
--- a/src/skippy/resident_prefix.cpp
+++ b/src/skippy/resident_prefix.cpp
@@ -7,6 +7,10 @@
 #include "llama-io.h"
 #include "llama-kv-cache.h"
 #include "llama-kv-cache-iswa.h"
+#include "llama-kv-cache-dsa.h"
+#include "llama-kv-cache-dsa-iswa.h"
+#include "llama-kv-cache-dsv4.h"
+#include "llama-kv-cache-msa.h"
 #include "llama-memory-hybrid.h"
 #include "llama-memory-hybrid-iswa.h"
 #include "llama-memory-recurrent.h"
@@ -180,6 +184,28 @@ skippy_status native_error(skippy_error ** error, const std::exception & excepti
 
 bool used_attention_cells(llama_memory_t memory, uint64_t * cells) {
     if (!memory) { *cells = 0; return true; }
+    if (auto * dsa = dynamic_cast<llama_kv_cache_dsa *>(memory)) {
+        *cells = std::max(dsa->get_mla()->get_used_cells(), dsa->get_lid()->get_used_cells());
+        return true;
+    }
+    if (auto * dsa_iswa = dynamic_cast<llama_kv_cache_dsa_iswa *>(memory)) {
+        uint64_t dsa_cells = 0;
+        if (!used_attention_cells(dsa_iswa->get_dsa(), &dsa_cells)) { return false; }
+        *cells = std::max(dsa_cells, static_cast<uint64_t>(dsa_iswa->get_swa()->get_used_cells()));
+        return true;
+    }
+    if (auto * msa = dynamic_cast<llama_kv_cache_msa *>(memory)) {
+        *cells = std::max(msa->get_base()->get_used_cells(), msa->get_idx()->get_used_cells());
+        return true;
+    }
+    if (auto * dsv4 = dynamic_cast<llama_kv_cache_dsv4 *>(memory)) {
+        uint64_t raw_cells = 0;
+        if (!used_attention_cells(dsv4->get_raw(), &raw_cells)) { return false; }
+        *cells = std::max({raw_cells, static_cast<uint64_t>(dsv4->get_csa()->get_used_cells()),
+                static_cast<uint64_t>(dsv4->get_hca()->get_used_cells()),
+                static_cast<uint64_t>(dsv4->get_lid()->get_used_cells())});
+        return true;
+    }
     if (auto * kv = dynamic_cast<llama_kv_cache *>(memory)) {
         *cells = kv->get_used_cells();
         return true;
-- 
2.56.1

